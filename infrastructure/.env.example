# =========================================================================
# Environment Variables Template (.env.example)
# Copy to .env and supply actual secret values for production deployment.
# NEVER commit .env with real production credentials.
# =========================================================================

# Database Configuration (MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=movie_rcm_db
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_strong_database_password_in_production
MYSQL_ROOT_PASSWORD=replace_with_strong_database_password_in_production
DATABASE_URL=mysql+pymysql://root:replace_with_strong_database_password_in_production@localhost:3306/movie_rcm_db?charset=utf8mb4

# Backend Mode:
# - Java Main:   BACKEND_INTERNAL_URL=http://127.0.0.1:8080
# - Python Main: BACKEND_INTERNAL_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8080

# Backend Service Configuration (Spring Boot - Java Main)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/movie_rcm_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_strong_database_password_in_production
APP_JWT_SECRET=replace_with_secure_random_base64_jwt_secret_at_least_256_bits

# Shared secret used for catalog sync between Spring Boot and FastAPI
CATALOG_SYNC_TOKEN=replace_with_secure_random_sync_token
