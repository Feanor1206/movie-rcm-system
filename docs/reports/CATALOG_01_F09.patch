+        }
+        int absExp = Math.abs(exp);
+        String expSign = exp >= 0 ? "+" : "-";
+        String expStr = (absExp < 10 ? "0" : "") + absExp;
+        return (negative ? "-" : "") + absM + "e" + expSign + expStr;
+    }
