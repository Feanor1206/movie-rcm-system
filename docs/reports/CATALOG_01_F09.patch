+    public static String formatDouble(double d) {
+        if (Double.isNaN(d) || Double.isInfinite(d)) return "null";
+        if (d == 0.0) {
+            return (Double.doubleToRawLongBits(d) == Double.doubleToRawLongBits(-0.0)) ? "-0.0" : "0.0";
+        }
