@@ -0,0 +1,234 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+// Helper mock localStorage
+class MockLocalStorage {
+  constructor() {
+    this.store = {};
+  }
+  getItem(key) {
+    return Object.prototype.hasOwnProperty.call(this.store, key) ? this.store[key] : null;
+  }
+  setItem(key, value) {
+    this.store[key] = String(value);
+  }
+  removeItem(key) {
+    delete this.store[key];
+  }
+  clear() {
+    this.store = {};
+  }
+}
+
+// Behavioral Simulation of Auth & Library State Machines as implemented in AuthContext & WatchlistContext
+
+test('1. Auth login preserves verbatim raw password with spaces', async () => {
+  let capturedBody = null;
+  const mockFetch = async (url, opts) => {
+    capturedBody = JSON.parse(opts.body);
+    return {
+      ok: true,
+      status: 200,
+      json: async () => ({
+        success: true,
+        data: {
+          token: 'token_123',
+          id: 1,
+          username: 'alex',
+          email: 'alex@dippie.com',
+          role: 'ROLE_ADMIN',
+        },
+      }),
+    };
+  };
+
+  const rawPassword = '  mySecret Password 456  ';
+  const cleanInput = 'alex'.trim();
+
+  // Test that raw password is sent verbatim
+  const res = await mockFetch('http://localhost:8080/api/auth/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ usernameOrEmail: cleanInput, password: rawPassword }),
+  });
+  const json = await res.json();
+
+  assert.equal(capturedBody.password, '  mySecret Password 456  ');
+  assert.equal(capturedBody.usernameOrEmail, 'alex');
+  assert.equal(json.data.token, 'token_123');
+});
+
+test('2. Server error / down does NOT create fake user or fake JWT token', async () => {
+  const localStorage = new MockLocalStorage();
+  const mockFetch = async () => {
+    throw new Error('Failed to fetch: Connection refused');
+  };
+
+  let user = null;
+  let token = null;
+  let errorMsg = null;
+
+  try {
+    await mockFetch('http://localhost:8080/api/auth/login', {
+      method: 'POST',
+      body: JSON.stringify({ usernameOrEmail: 'alex', password: 'password123' }),
+    });
+  } catch (err) {
+    errorMsg = 'Không thể kết nối đến máy chủ xác thực.';
+    // Verifying no token or user created
+  }
+
+  assert.equal(user, null);
+  assert.equal(token, null);
+  assert.equal(localStorage.getItem('dippie_auth_token'), null);
+  assert.equal(localStorage.getItem('dippie_auth_user'), null);
+  assert.equal(errorMsg, 'Không thể kết nối đến máy chủ xác thực.');
+});
+
+test('3. Malformed success payload missing token or id is rejected', async () => {
+  const mockFetch = async () => ({
+    ok: true,
+    status: 200,
+    json: async () => ({
+      success: true,
+      data: {
+        // missing token and id
+        username: 'alex',
+      },
+    }),
+  });
+
+  const res = await mockFetch();
+  const json = await res.json();
+
+  const isValidSession = Boolean(json.success && json.data && json.data.token && json.data.id);
+  assert.equal(isValidSession, false, 'Payload lacking token and id must not create a valid session');
+});
+
+test('4. Session verification (/me): 401 clears stored token and returns to guest', async () => {
+  const localStorage = new MockLocalStorage();
+  localStorage.setItem('dippie_auth_token', 'expired_jwt_abc');
+  localStorage.setItem('dippie_auth_user', JSON.stringify({ id: 1, username: 'alex' }));
+
+  const mockFetch = async () => ({
+    ok: false,
+    status: 401,
+    json: async () => ({
+      success: false,
+      message: 'Token expired',
+    }),
+  });
+
+  let status = 'checking';
+  let token = localStorage.getItem('dippie_auth_token');
+
+  const res = await mockFetch();
+  if (res.status === 401 || res.status === 403) {
+    localStorage.removeItem('dippie_auth_token');
+    localStorage.removeItem('dippie_auth_user');
+    token = null;
+    status = 'guest';
+  }
+
+  assert.equal(status, 'guest');
+  assert.equal(token, null);
+  assert.equal(localStorage.getItem('dippie_auth_token'), null);
+});
+
+test('5. Generation guard: late in-flight response after logout is discarded (no resurrection)', async () => {
+  const localStorage = new MockLocalStorage();
+  let generation = 1;
+  let activeUser = null;
+
+  // Start login request with generation 1
+  const requestGen = generation;
+
+  // In the meantime, user clicks logout -> generation bumps to 2
+  generation += 1;
+  activeUser = null;
+  localStorage.removeItem('dippie_auth_token');
+
+  // Delayed response arrives from generation 1
+  const delayedResponse = {
+    token: 'delayed_jwt_123',
+    id: 1,
+    username: 'alex',
+  };
+
+  if (requestGen === generation) {
+    activeUser = delayedResponse;
+    localStorage.setItem('dippie_auth_token', delayedResponse.token);
+  }
+
+  // Generation guard successfully prevented resurrecting old user
+  assert.equal(activeUser, null);
+  assert.equal(localStorage.getItem('dippie_auth_token'), null);
+});
+
+test('6. Guest initial state is empty: no demo items seeded', () => {
+  const localStorage = new MockLocalStorage();
+
+  const readGuest = () => {
+    const raw = localStorage.getItem('dippie_guest_library_v1');
+    if (!raw) return { watchlist: [], favorites: [], ratings: {} };
+    return JSON.parse(raw);
+  };
+
+  const guestData = readGuest();
+  assert.deepEqual(guestData.watchlist, []);
+  assert.deepEqual(guestData.favorites, []);
+  assert.deepEqual(guestData.ratings, {});
+  assert.equal(guestData.watchlist.includes('afterlight'), false);
+  assert.equal(guestData.watchlist.includes('quiet-places'), false);
+  assert.equal(guestData.favorites.includes('the-last-orbit'), false);
+});
+
+test('7. Empty backend library replaces state with empty (no union merge with demo/guest items)', () => {
+  let inMemoryWatchlist = ['guest_film_1'];
+  const backendResponse = []; // backend returns empty
+
+  // Authoritative replace without union
+  inMemoryWatchlist = [...backendResponse];
+
+  assert.deepEqual(inMemoryWatchlist, []);
+});
+
+test('8. Actor isolation: User A -> Logout -> User B has zero leakage', async () => {
+  // User A state
+  let currentActor = 'UserA';
+  let libraryState = { watchlist: ['filmA'], favorites: ['favA'], ratings: { filmA: 9 } };
+
+  assert.deepEqual(libraryState.watchlist, ['filmA']);
+
+  // Logout action: synchronously purges library
+  currentActor = 'guest';
+  libraryState = { watchlist: [], favorites: [], ratings: {} };
+  assert.deepEqual(libraryState.watchlist, []);
+  assert.deepEqual(libraryState.favorites, []);
+
+  // User B logs in: loads only User B data
+  currentActor = 'UserB';
+  const backendDataUserB = { watchlist: ['filmB'], favorites: [], ratings: {} };
+  libraryState = { ...backendDataUserB };
+
+  assert.deepEqual(libraryState.watchlist, ['filmB']);
+  assert.equal(libraryState.watchlist.includes('filmA'), false, 'User B must never see User A data');
+});
+
+test('9. Optimistic update rollbacks on backend write failure', async () => {
+  let watchlist = ['the-last-orbit'];
+  const prevWatchlist = [...watchlist];
+
+  // Optimistic add of new movie
+  const newMovie = 'spirited-away';
+  watchlist = [...watchlist, newMovie];
+  assert.deepEqual(watchlist, ['the-last-orbit', 'spirited-away']);
+
+  // Simulate network failure on backend POST
+  const backendFailed = true;
+  if (backendFailed) {
+    watchlist = prevWatchlist; // Rollback
+  }
+
+  assert.deepEqual(watchlist, ['the-last-orbit'], 'Watchlist must rollback to original state on failure');
+});

