+        @Override
+        public void close() {
+            closeCalls.incrementAndGet();
+            closeStarted.countDown();
+            try {
+                awaitIgnoringInterrupt(releaseClose);
+            } finally {
+                closeCompleted.countDown();
+            }
+        }
+
+        int closeCalls() {
+            return closeCalls.get();
+        }
+
+        CountDownLatch closeStarted() {
