+    /**
+     * Escape special SQL LIKE metacharacters: backslash, percent, underscore.
+     */
+    private String escapeLike(String input) {
+        if (input == null) return "";
+        return input.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_");
+    }
+
+    /**
+     * R1: Exact CSV genre token predicate.
+     * Matches token T case-insensitively as an exact item in a comma-separated list.
+     * Handles:
+     * - Single token: "drama"
+     * - Start of list: "drama,..." or "drama ,..."
+     * - End of list: "...,drama" or "..., drama" or "... ,drama" or "... , drama"
+     * - Middle of list: "...,drama,..." or "..., drama,..." or "...,drama ,..." or "..., drama ,..."
+     * Escapes input wildcards (%) and (_) to avoid unintended pattern expansion.
+     * Guarantees "Drama" does not match "Melodrama", and "Animation" does not match "NonAnimation".
+     */
+    private Predicate buildGenreTokenPredicate(CriteriaBuilder cb, Root<Movie> root, String rawToken) {
+        if (rawToken == null || rawToken.trim().isEmpty()) {
+            return cb.conjunction();
+        }
+        String token = rawToken.trim().toLowerCase();
+        String esc = escapeLike(token);
+
+        Expression<String> g = cb.lower(root.get("genres"));
+
+        Predicate eq1 = cb.equal(g, token);
+        Predicate eq2 = cb.equal(cb.trim(g), token);
+
+        Predicate startsWith1 = cb.like(g, esc + ",%", '\\');
+        Predicate startsWith2 = cb.like(g, esc + " ,%", '\\');
+        Predicate startsWith3 = cb.like(g, esc + ", %", '\\');
+        Predicate startsWith4 = cb.like(g, esc + " , %", '\\');
+
+        Predicate endsWith1 = cb.like(g, "%," + esc, '\\');
+        Predicate endsWith2 = cb.like(g, "%, " + esc, '\\');
+        Predicate endsWith3 = cb.like(g, "% ," + esc, '\\');
+        Predicate endsWith4 = cb.like(g, "% , " + esc, '\\');
+
+        Predicate mid1 = cb.like(g, "%," + esc + ",%", '\\');
+        Predicate mid2 = cb.like(g, "%, " + esc + ",%", '\\');
+        Predicate mid3 = cb.like(g, "%," + esc + " ,%", '\\');
+        Predicate mid4 = cb.like(g, "%, " + esc + " ,%", '\\');
+        Predicate mid5 = cb.like(g, "%," + esc + ", %", '\\');
+        Predicate mid6 = cb.like(g, "%, " + esc + ", %", '\\');
+
+        return cb.and(
+                cb.isNotNull(g),
+                cb.or(
+                        eq1, eq2,
+                        startsWith1, startsWith2, startsWith3, startsWith4,
+                        endsWith1, endsWith2, endsWith3, endsWith4,
+                        mid1, mid2, mid3, mid4, mid5, mid6
+                )
+        );
+    }
+
+    /**
+     * R2: Consistent search predicate searching title OR description.
+     * Safely handles null description and escapes literal wildcards.
+     */
+    private Predicate buildSearchPredicate(CriteriaBuilder cb, Root<Movie> root, String rawQuery) {
+        if (rawQuery == null || rawQuery.trim().isEmpty()) {
+            return cb.conjunction();
+        }
+        String term = "%" + escapeLike(rawQuery.trim().toLowerCase()) + "%";
+        Predicate titleMatch = cb.like(cb.lower(root.get("title")), term, '\\');
+        Predicate descMatch = cb.and(
+                cb.isNotNull(root.get("description")),
+                cb.like(cb.lower(root.get("description")), term, '\\')
+        );
+        return cb.or(titleMatch, descMatch);
+    }
+
