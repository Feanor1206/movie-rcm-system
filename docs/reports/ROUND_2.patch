+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import ts from '../node_modules/typescript/lib/typescript.js';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const serviceFile = path.resolve(__dirname, '../lib/services/catalogService.ts');
+
+function loadService(mockFetch) {
+  const code = fs.readFileSync(serviceFile, 'utf8');
+  const compiled = ts.transpileModule(code, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+  }).outputText;
+
+  const sandbox = {
+    exports: {},
+    module: { exports: {} },
+    fetch: mockFetch,
+    process: { env: { NEXT_PUBLIC_SPRINGBOOT_API_URL: 'http://test-server/api' } },
+    URLSearchParams,
+    AbortController,
+    setTimeout,
+    clearTimeout,
+    Error,
+    Array,
+    String,
+    Boolean,
+    console,
+  };
+  vm.runInNewContext(compiled, sandbox);
+  return sandbox.module.exports.browseCatalog ? sandbox.module.exports : sandbox.exports;
+}
+
+test('1. Catalog Client: browseCatalog constructs correct query string and normalizes PageResponse', async () => {
+  let requestedUrl = '';
+  const mockFetch = async (url) => {
+    requestedUrl = url;
+    return {
+      ok: true,
+      status: 200,
+      json: async () => ({
+        success: true,
+        message: 'Movies retrieved successfully',
+        data: {
+          items: [
+            {
+              id: 'spirited-away',
+              title: 'Spirited Away',
+              year: 2001,
+              rating: 8.6,
+              runtime: '2h 05m',
+              genres: ['Animation', 'Adventure'],
+              description: 'Magical bathhouse',
+              poster: 'https://img/poster.jpg',
+              backdrop: null, // nullable test
+              videoUrl: null,
+            },
+          ],
+          page: 0,
+          size: 12,
+          totalElements: 1,
+          totalPages: 1,
+          hasNext: false,
+          hasPrevious: false,
+        },
+      }),
+    };
+  };
+
+  const service = loadService(mockFetch);
+  const result = await service.browseCatalog({
+    query: 'magical',
+    genre: 'Animation',
+    genres: ['Animation', 'Adventure'],
+    animationOnly: true,
+    yearMin: 2000,
+    yearMax: 2025,
+    sort: 'rating',
+    direction: 'desc',
+    page: 0,
+    size: 12,
+  });
+
+  assert.ok(requestedUrl.includes('/movies/browse?'));
+  assert.ok(requestedUrl.includes('query=magical'));
+  assert.ok(requestedUrl.includes('genre=Animation'));
+  assert.ok(requestedUrl.includes('genres=Animation%2CAdventure'));
+  assert.ok(requestedUrl.includes('animationOnly=true'));
+  assert.ok(requestedUrl.includes('yearMin=2000'));
+  assert.ok(requestedUrl.includes('yearMax=2025'));
+  assert.ok(requestedUrl.includes('sort=rating'));
+  assert.ok(requestedUrl.includes('direction=desc'));
+  assert.ok(requestedUrl.includes('page=0'));
+  assert.ok(requestedUrl.includes('size=12'));
+
+  assert.equal(result.totalElements, 1);
+  assert.equal(result.items[0].id, 'spirited-away');
+  assert.equal(result.items[0].backdrop, ''); // safe fallback for null
+  assert.equal(result.items[0].videoUrl, undefined);
+});
+
+test('2. Catalog Client: getCatalogMovieById returns null on 404, movie on 200', async () => {
+  const mockFetch = async (url) => {
+    if (url.includes('nonexistent')) {
+      return {
+        ok: false,
+        status: 404,
+        json: async () => ({ success: false, message: 'Movie not found', data: null }),
+      };
+    }
+    return {
+      ok: true,
+      status: 200,
+      json: async () => ({
+        success: true,
+        data: { id: 'your-name', title: 'Your Name', year: 2016, rating: 8.4, genres: ['Animation'] },
+      }),
+    };
+  };
+
+  const service = loadService(mockFetch);
+
+  // 404 returns null (not throwing)
+  const notFoundMovie = await service.getCatalogMovieById('nonexistent');
+  assert.equal(notFoundMovie, null);
+
+  // 200 returns Movie object
+  const movie = await service.getCatalogMovieById('your-name');
+  assert.ok(movie);
+  assert.equal(movie.id, 'your-name');
+  assert.equal(movie.title, 'Your Name');
+});
+
+test('3. Catalog Client: 400 validation error throws CatalogApiError with status 400', async () => {
+  const mockFetch = async () => ({
+    ok: false,
+    status: 400,
+    json: async () => ({ success: false, message: 'Tham số tìm kiếm không hợp lệ: size phải từ 1 đến 100' }),
+  });
+
+  const service = loadService(mockFetch);
+  await assert.rejects(
+    async () => {
+      await service.browseCatalog({ size: 0 });
+    },
+    (err) => {
+      assert.equal(err.name, 'CatalogApiError');
+      assert.equal(err.status, 400);
+      assert.match(err.message, /Tham số tìm kiếm không hợp lệ/);
+      return true;
+    }
+  );
+});
+
+test('4. Catalog Client: Request timeout throws CatalogApiError with status 408', async () => {
+  const mockFetch = (url, opts) =>
+    new Promise((_, reject) => {
+      opts.signal.addEventListener('abort', () => {
+        const error = new Error('The operation was aborted');
+        error.name = 'AbortError';
+        reject(error);
+      });
+    });
+
+  const service = loadService(mockFetch);
+  await assert.rejects(
+    async () => {
+      await service.browseCatalog({ timeoutMs: 50 });
+    },
+    (err) => {
+      assert.equal(err.name, 'CatalogApiError');
+      assert.equal(err.status, 408);
+      assert.match(err.message, /timeout/);
+      return true;
+    }
+  );
+});
