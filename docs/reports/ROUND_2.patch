+++ b/frontend/lib/services/catalogService.ts
@@ -0,0 +1,247 @@
+import type { Movie } from '@/types/movie';
+
+export type PageResponse<T> = {
+  items: T[];
+  page: number;
+  size: number;
+  totalElements: number;
+  totalPages: number;
+  hasNext: boolean;
+  hasPrevious: boolean;
+};
+
+export type CatalogBrowseOptions = {
+  query?: string;
+  search?: string;
+  genre?: string;
+  genres?: string | string[];
+  animationOnly?: boolean;
+  yearMin?: number;
+  yearMax?: number;
+  sort?: 'rating' | 'year' | 'title';
+  direction?: 'asc' | 'desc';
+  page?: number;
+  size?: number;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+};
+
+export class CatalogApiError extends Error {
+  status: number;
+  data?: unknown;
+
+  constructor(message: string, status: number, data?: unknown) {
+    super(message);
+    this.name = 'CatalogApiError';
+    this.status = status;
+    this.data = data;
+  }
+}
+
+const DEFAULT_TIMEOUT_MS = 7000;
+const SPRINGBOOT_API = process.env.NEXT_PUBLIC_SPRINGBOOT_API_URL || 'http://localhost:8080/api';
+
+/**
+ * Normalizes a raw backend movie response into the frontend Movie type,
+ * providing safe fallbacks for nullable metadata fields.
+ */
+export function normalizeCatalogMovie(raw: any): Movie {
+  if (!raw || typeof raw !== 'object') {
+    throw new CatalogApiError('Dữ liệu phim từ máy chủ không hợp lệ', 500);
+  }
+
+  const genres = Array.isArray(raw.genres)
+    ? raw.genres.map((g: unknown) => String(g).trim()).filter(Boolean)
+    : [];
+
+  return {
+    id: String(raw.id || ''),
+    title: String(raw.title || 'Chưa có tiêu đề'),
+    year: typeof raw.year === 'number' ? raw.year : 0,
+    rating: typeof raw.rating === 'number' ? raw.rating : 0.0,
+    runtime: raw.runtime ? String(raw.runtime) : '',
+    genres,
+    description: raw.description ? String(raw.description) : '',
+    poster: raw.poster ? String(raw.poster) : '',
+    backdrop: raw.backdrop ? String(raw.backdrop) : '',
+    videoUrl: raw.videoUrl ? String(raw.videoUrl) : undefined,
+  };
+}
+
+/**
+ * Internal fetch helper wrapping both network request and JSON body parsing
+ * inside a unified timeout window.
+ */
+async function fetchWithTimeout(
+  url: string,
+  timeoutMs = DEFAULT_TIMEOUT_MS,
+  externalSignal?: AbortSignal
+): Promise<Response> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => {
+    controller.abort(new Error(`Catalog request timed out after ${timeoutMs}ms`));
+  }, timeoutMs);
+
+  const abortListener = () => controller.abort(externalSignal?.reason);
+  if (externalSignal) {
+    if (externalSignal.aborted) {
+      clearTimeout(timer);
+      throw externalSignal.reason || new Error('Aborted');
+    }
+    externalSignal.addEventListener('abort', abortListener);
+  }
+
+  try {
+    const res = await fetch(url, {
+      method: 'GET',
+      headers: {
+        Accept: 'application/json',
+      },
+      signal: controller.signal,
+    });
+    return res;
+  } finally {
+    clearTimeout(timer);
+    if (externalSignal) {
+      externalSignal.removeEventListener('abort', abortListener);
+    }
+  }
+}
+
+/**
+ * Browse catalog movies with pagination, filtering, and sorting.
+ */
+export async function browseCatalog(
+  options: CatalogBrowseOptions = {},
+  baseUrl = SPRINGBOOT_API
+): Promise<PageResponse<Movie>> {
+  const params = new URLSearchParams();
+
+  const effectiveQuery = (options.query ?? options.search ?? '').trim();
+  if (effectiveQuery) {
+    params.set('query', effectiveQuery);
+  }
+
+  if (options.genre && options.genre.trim()) {
+    params.set('genre', options.genre.trim());
+  }
+
+  if (options.genres) {
+    const genresStr = Array.isArray(options.genres)
+      ? options.genres.map((g) => g.trim()).filter(Boolean).join(',')
+      : options.genres.trim();
+    if (genresStr) {
+      params.set('genres', genresStr);
+    }
+  }
+
+  if (options.animationOnly) {
+    params.set('animationOnly', 'true');
+  }
+
+  if (typeof options.yearMin === 'number') {
+    params.set('yearMin', String(options.yearMin));
+  }
+
+  if (typeof options.yearMax === 'number') {
+    params.set('yearMax', String(options.yearMax));
+  }
+
+  if (options.sort) {
+    params.set('sort', options.sort);
+  }
+
+  if (options.direction) {
+    params.set('direction', options.direction);
+  }
+
+  if (typeof options.page === 'number') {
+    params.set('page', String(options.page));
+  }
+
+  if (typeof options.size === 'number') {
+    params.set('size', String(options.size));
+  }
+
+  const queryString = params.toString();
+  const url = `${baseUrl}/movies/browse${queryString ? `?${queryString}` : ''}`;
+
+  let res: Response;
+  try {
+    res = await fetchWithTimeout(url, options.timeoutMs, options.signal);
+  } catch (err: any) {
+    if (err?.name === 'AbortError' || err?.message?.includes('timed out')) {
+      throw new CatalogApiError('Yêu cầu danh mục quá thời gian phản hồi (timeout)', 408);
+    }
+    throw new CatalogApiError('Không thể kết nối đến máy chủ danh mục phim', 0);
+  }
+
+  let body: any;
+  try {
+    body = await res.json();
+  } catch {
+    throw new CatalogApiError('Máy chủ phản hồi định dạng dữ liệu không hợp lệ', res.status);
+  }
+
+  if (!res.ok || !body?.success) {
+    const errorMsg = body?.message || `Lỗi danh mục phim (${res.status})`;
+    throw new CatalogApiError(errorMsg, res.status, body);
+  }
+
+  const data = body.data;
+  const rawItems = Array.isArray(data?.items) ? data.items : [];
+  const items = rawItems.map(normalizeCatalogMovie);
+
+  return {
+    items,
+    page: typeof data?.page === 'number' ? data.page : 0,
+    size: typeof data?.size === 'number' ? data.size : items.length,
+    totalElements: typeof data?.totalElements === 'number' ? data.totalElements : items.length,
+    totalPages: typeof data?.totalPages === 'number' ? data.totalPages : 1,
+    hasNext: Boolean(data?.hasNext),
+    hasPrevious: Boolean(data?.hasPrevious),
+  };
+}
+
+/**
+ * Fetch a single catalog movie by canonical ID.
+ * Returns null if 404 Not Found (distinguishes nonexistent from network/server error).
+ */
+export async function getCatalogMovieById(
+  id: string,
+  options: { signal?: AbortSignal; timeoutMs?: number } = {},
+  baseUrl = SPRINGBOOT_API
+): Promise<Movie | null> {
+  if (!id || !id.trim()) {
+    throw new CatalogApiError('ID phim không hợp lệ', 400);
+  }
+
+  const url = `${baseUrl}/movies/${encodeURIComponent(id.trim())}`;
+  let res: Response;
+  try {
+    res = await fetchWithTimeout(url, options.timeoutMs, options.signal);
+  } catch (err: any) {
+    if (err?.name === 'AbortError' || err?.message?.includes('timed out')) {
+      throw new CatalogApiError('Yêu cầu xem chi tiết phim quá thời gian phản hồi', 408);
+    }
+    throw new CatalogApiError('Không thể kết nối đến máy chủ danh mục phim', 0);
+  }
+
+  let body: any;
+  try {
+    body = await res.json();
+  } catch {
+    throw new CatalogApiError('Máy chủ phản hồi định dạng dữ liệu không hợp lệ', res.status);
+  }
+
+  if (res.status === 404 || (!body?.success && res.status === 404)) {
+    return null;
+  }
+
+  if (!res.ok || !body?.success) {
+    const errorMsg = body?.message || `Lỗi xem chi tiết phim (${res.status})`;
+    throw new CatalogApiError(errorMsg, res.status, body);
+  }
+
+  return normalizeCatalogMovie(body.data);
+}
