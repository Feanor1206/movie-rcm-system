+
+    return {
+      ok: false,
+      status: 404,
+      json: async () => ({ success: false, message: 'Not found' }),
+    };
+  };
+
+  // Helper to mount production WatchlistProvider with persisted fetcher
+  function mountProductionProvider(fetcher) {
+    let slots = [];
+    let hookIndex = 0;
+    let effects = [];
+    let changed = false;
+    let value = null;
+    const same = (a, b) => a && b && a.length === b.length && a.every((x, i) => Object.is(x, b[i]));
+
+    const hooks = {
+      createContext: () => ({ Provider: 'Provider' }),
+      useContext: () => null,
+      useState(initial) {
+        const i = hookIndex++;
+        if (!slots[i]) slots[i] = { v: typeof initial === 'function' ? initial() : initial };
+        return [
+          slots[i].v,
+          (v) => {
+            slots[i].v = typeof v === 'function' ? v(slots[i].v) : v;
+            changed = true;
+          },
+        ];
+      },
+      useRef(initial) {
+        const i = hookIndex++;
+        if (!slots[i]) slots[i] = { current: initial };
+        return slots[i];
+      },
+      useCallback(fn, deps) {
+        const i = hookIndex++;
+        if (!slots[i] || !same(slots[i].deps, deps)) slots[i] = { v: fn, deps };
+        return slots[i].v;
+      },
+      useEffect(fn, deps) {
+        const i = hookIndex++;
+        if (!slots[i] || !same(slots[i].deps, deps)) {
+          const prev = slots[i];
+          slots[i] = { deps, cleanup: prev?.cleanup };
+          effects.push(() => {
+            prev?.cleanup?.();
+            slots[i].cleanup = fn();
+          });
+        }
+      },
+      useMemo(fn, deps) {
+        const i = hookIndex++;
+        if (!slots[i] || !same(slots[i].deps, deps)) slots[i] = { v: fn(), deps };
+        return slots[i].v;
+      },
+      createElement(type, props, ...children) {
