+test('4. Profile: Resolves all canonical IDs via API, uses bounded cache, and distinguishes orphan from network error', async () => {
+  const fetchCalls = [];
+
+  const mockGetCatalog = async (id) => {
+    fetchCalls.push(id);
+    if (id === 'orphan-id') return null; // 404
+    if (id === 'error-id') throw new Error('Network timeout 504');
+    return sampleMovie({ id, title: `Title for ${id}` });
+  };
+
+  // Profile with 3 items: valid item, orphan item (404), and error item (500)
+  const initialLibrary = {
+    watchlist: ['movie-1', 'orphan-id', 'error-id'],
+    favorites: ['movie-1'], // Same ID 'movie-1' will test cache deduplication
+    ratings: {},
+  };
+
+  const h = createProfileHarness(initialLibrary, mockGetCatalog);
+  h.render();
+  await h.settle();
+
+  // Assert API was called for 'movie-1' (even though it might be a known title, must use API)
+  assert.ok(fetchCalls.includes('movie-1'), 'All canonical IDs must be resolved via getCatalogMovieById');
+  assert.ok(fetchCalls.includes('orphan-id'), 'Orphan ID resolved via API');
+  assert.ok(fetchCalls.includes('error-id'), 'Error ID resolved via API');
+
+  // Assert deduplication / cache: 'movie-1' was in both watchlist and favorites, but fetched only once
+  const movie1Calls = fetchCalls.filter((id) => id === 'movie-1');
+  assert.equal(movie1Calls.length, 1, 'Bounded metadata cache prevents duplicate network requests for same ID');
+
+  // Valid movie-1 is rendered as MovieCard with movie prop
+  const cardNodes = findNodes(h.tree, (n) => n.type === 'MovieCard');
+  assert.equal(cardNodes.length, 1, 'One valid item rendered as MovieCard');
+  assert.equal(cardNodes[0].props.movie.title, 'Title for movie-1');
+
+  const treeText = getText(h.tree);
+
+  // Orphan item (404) is marked as absent from catalog with removal action
+  assert.ok(treeText.includes('Không có trong catalog (404)'), '404 item marked as orphan');
+
+  // Error item (network failure) is marked with connection error and retry, NOT treated as orphan/removed!
+  assert.ok(
+    treeText.includes('Không thể kết nối máy chủ để tải thông tin phim'),
+    'Network failure marked as connection error'
+  );
+  assert.ok(
+    treeText.includes('Thử tải lại'),
+    'Connection error provides retry button'
+  );
+});
