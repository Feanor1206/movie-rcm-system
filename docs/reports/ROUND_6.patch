+test('3. MovieDetail: Safe media fallbacks (missing backdrop, missing poster, and video playback capability)', () => {
+  // 3A. Movie with missing backdrop and missing poster
+  const minimalMovie = sampleMovie({
+    id: 'minimal-movie',
+    title: 'Minimal Anime',
+    backdrop: '',
+    poster: '',
+    videoUrl: '', // No video
+  });
