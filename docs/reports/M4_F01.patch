+    console.log(`🚀 Launching Next.js Standalone server on port ${nextPort}...`);
+    const proc = spawn(process.execPath, [STANDALONE_SERVER], {
+      cwd: STANDALONE_DIR,
+      env: {
+        ...process.env,
+        PORT: String(nextPort),
