+      command: 'GET http://127.0.0.1:3005/',
+      obs: 'Editorial Hero loads top animation "The Last Orbit" (8.4/10), green theme banner, active navigation links.',
+    });
+
+    // 02. Keyboard Navigation Focus
+    for (let k = 0; k < 6; k++) {
