+++ b/scripts/drive-tests/test_drive_toolkit_comprehensive.ps1
@@ -0,0 +1,754 @@
+﻿<#
+.SYNOPSIS
+    Comprehensive test suite for Google Drive operational tooling on Windows.
+.DESCRIPTION
+    Validates:
+    1. Parameter handling: Whitespace, Unicode (Vietnamese, Japanese, diacritics), and complex paths
+       in Remote, RemoteSubpath, MountPoint, and ConfigPath.
+    2. Dry-Run mode: Both explicit (-WhatIf) and implicit (omitting -Execute), confirming zero
+       background processes launched and zero state files persisted on disk.
+    3. Mount collision detection (Occupied Mount Target): Active drive letters (e.g. C:, C:\) and
+       non-empty directories, asserting proper collision detection and blocking.
+    4. Baseline streaming flags: Exact enforcement of --read-only, --vfs-cache-mode off,
+       --buffer-size 32M, --vfs-read-chunk-size 8M, --vfs-read-chunk-size-limit 32M,
+       --vfs-read-chunk-streams 0, and auxiliary flags.
+.OUTPUTS
+    Console test execution report, exit code 0/1, and structured JSON evidence in
+    docs/reports/drive/DRIVE_01/agent-e/toolkit_test_evidence.json.
+#>
+[CmdletBinding()]
+param(
+    [string]$EvidencePath,
+    [switch]$VerboseOutput,
+    [switch]$NoExit
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+# Ensure UTF-8 output encoding across Windows PowerShell 5.1 and PowerShell 7
+try {
+    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
+} catch {}
+$OutputEncoding = [System.Text.Encoding]::UTF8
+
+$scriptDir = $PSScriptRoot
+$toolkitDir = (Resolve-Path (Join-Path $scriptDir "..\drive")).Path
+$preflightPath = Join-Path $toolkitDir "preflight_drive.ps1"
+$mountPath     = Join-Path $toolkitDir "mount_drive.ps1"
+$statusPath    = Join-Path $toolkitDir "status_drive.ps1"
+$stopPath      = Join-Path $toolkitDir "stop_drive.ps1"
+
+if (-not $EvidencePath) {
+    $EvidencePath = Join-Path $scriptDir "..\..\docs\reports\drive\DRIVE_01\agent-e\toolkit_test_evidence.json"
+}
+
+# Verify toolkit scripts exist
+$missingFiles = @()
+foreach ($f in @($preflightPath, $mountPath, $statusPath, $stopPath)) {
+    if (-not (Test-Path -Path $f -PathType Leaf)) {
+        $missingFiles += $f
+    }
+}
+if ($missingFiles.Count -gt 0) {
+    throw "Required toolkit scripts not found: $($missingFiles -join ', ')"
+}
+
+$suiteStopwatch = [System.Diagnostics.Stopwatch]::StartNew()
+$results = [System.Collections.Generic.List[PSCustomObject]]::new()
+
+function Register-TestResult {
+    param(
+        [string]$TestId,
+        [string]$Category,
+        [string]$Name,
+        [string]$Description,
+        [bool]$Passed,
+        [string]$FailureMessage = "",
+        [object]$Expected = $null,
+        [object]$Actual = $null,
+        [double]$DurationMs = 0
+    )
+
+    if ($Passed) {
+        $FailureMessage = ""
+    }
+
+    $obj = [PSCustomObject]@{
+        TestId         = $TestId
+        Category       = $Category
+        Name           = $Name
+        Description    = $Description
+        Passed         = $Passed
+        FailureMessage = $FailureMessage
+        Expected       = $Expected
+        Actual         = $Actual
+        DurationMs     = [math]::Round($DurationMs, 2)
+    }
+
+    $results.Add($obj)
+
+    if ($Passed) {
+        Write-Host "  [PASS] $TestId : $Name ($([math]::Round($DurationMs, 1)) ms)" -ForegroundColor Green
+    } else {
+        Write-Host "  [FAIL] $TestId : $Name" -ForegroundColor Red
+        Write-Host "         Reason: $FailureMessage" -ForegroundColor DarkRed
+        if ($Expected -ne $null) { Write-Host "         Expected: $Expected" -ForegroundColor DarkGray }
+        if ($Actual -ne $null)   { Write-Host "         Actual:   $Actual" -ForegroundColor DarkGray }
+    }
+}
+
+Write-Host "================================================================================" -ForegroundColor Cyan
+Write-Host " AGENT E: COMPREHENSIVE TOOLKIT VERIFICATION (DRIVE-01)" -ForegroundColor Cyan
+Write-Host " Target Toolkit : $toolkitDir" -ForegroundColor Cyan
+Write-Host " Target Evidence: $EvidencePath" -ForegroundColor Cyan
+Write-Host "================================================================================" -ForegroundColor Cyan
+
+# ==============================================================================
+# SUITE 1: Parameter Handling - Whitespace, Unicode & Complex Paths
+# ==============================================================================
+Write-Host "`n--- [SUITE 1] Parameter Robustness: Whitespace, Unicode & Complex Paths ---" -ForegroundColor Yellow
+
+# Test 1.1: Remote with spaces and Vietnamese Unicode subpath
+$t1Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $remoteWithSpace = "cinema gdrive:"
+    $unicodeSubpath = "Kho Phim Việt/1080p - Bản Rõ & Đầy Đủ [2026]"
+    $plan1 = & $mountPath -WhatIf -Remote $remoteWithSpace -RemoteSubpath $unicodeSubpath -MountPoint "M:"
+    $t1Sw.Stop()
+
+    $expectedTarget = "$remoteWithSpace$unicodeSubpath"
+    $hasExpectedTarget = ($plan1.RemoteTarget -eq $expectedTarget)
+    $cmdContainsTarget = ($plan1.ExpectedCommand -match [regex]::Escape($expectedTarget))
+    $subpathPreserved = ($plan1.RemoteSubpath -eq $unicodeSubpath)
+
+    $p1Passed = ($hasExpectedTarget -and $cmdContainsTarget -and $subpathPreserved)
+    $msg = if (-not $p1Passed) { "Mismatch in target formatting or unicode preservation" } else { "" }
+    Register-TestResult -TestId "TC-PARAM-01" -Category "Parameters" `
+        -Name "Remote with whitespace and Vietnamese Unicode subpath" `
+        -Description "Validates remote names containing spaces and subpaths with Vietnamese diacritics and brackets" `
+        -Passed $p1Passed -FailureMessage $msg `
+        -Expected $expectedTarget -Actual $plan1.RemoteTarget -DurationMs $t1Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t1Sw.Stop()
+    Register-TestResult -TestId "TC-PARAM-01" -Category "Parameters" `
+        -Name "Remote with whitespace and Vietnamese Unicode subpath" `
+        -Description "Validates remote names containing spaces and subpaths with Vietnamese diacritics and brackets" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t1Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 1.2: Remote without trailing colon and Japanese/CJK Unicode subpath
+$t2Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $remoteNoColon = "anime-gdrive"
+    $cjkSubpath = "スタジオジブリ/映画/となりのトトロ (1988) [BD-Rip]"
+    $plan2 = & $mountPath -WhatIf -Remote $remoteNoColon -RemoteSubpath $cjkSubpath -MountPoint "M:"
+    $t2Sw.Stop()
+
+    $expectedTarget2 = "$remoteNoColon`:$cjkSubpath"
+    $hasColonNormalized = ($plan2.RemoteTarget -eq $expectedTarget2)
+    $cmdMatches = ($plan2.ExpectedCommand -match [regex]::Escape($expectedTarget2))
+
+    $p2Passed = ($hasColonNormalized -and $cmdMatches)
+    $msg = if (-not $p2Passed) { "Failed to append colon properly or lost CJK characters" } else { "" }
+    Register-TestResult -TestId "TC-PARAM-02" -Category "Parameters" `
+        -Name "Remote without trailing colon and CJK Unicode subpath" `
+        -Description "Validates automatic colon appending when omitted and preservation of CJK characters" `
+        -Passed $p2Passed -FailureMessage $msg `
+        -Expected $expectedTarget2 -Actual $plan2.RemoteTarget -DurationMs $t2Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t2Sw.Stop()
+    Register-TestResult -TestId "TC-PARAM-02" -Category "Parameters" `
+        -Name "Remote without trailing colon and CJK Unicode subpath" `
+        -Description "Validates automatic colon appending when omitted and preservation of CJK characters" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t2Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 1.3: Empty Remote defaults to cinema-gdrive: and empty RemoteSubpath
+$t3Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $plan3 = & $mountPath -WhatIf -Remote "" -RemoteSubpath "" -MountPoint "M:"
+    $t3Sw.Stop()
+
+    $expectedTarget3 = "cinema-gdrive:"
+    $targetIsClean = ($plan3.RemoteTarget -eq $expectedTarget3)
+    $noDoubleColons = (-not ($plan3.RemoteTarget -match "::"))
+
+    $p3Passed = ($targetIsClean -and $noDoubleColons)
+    $msg = if (-not $p3Passed) { "Empty remote or empty subpath resulted in malformed target: $($plan3.RemoteTarget)" } else { "" }
+    Register-TestResult -TestId "TC-PARAM-03" -Category "Parameters" `
+        -Name "Empty Remote fallback and empty RemoteSubpath clean handling" `
+        -Description "Validates fallback to cinema-gdrive: without double colon or syntax errors when subpath is empty" `
+        -Passed $p3Passed -FailureMessage $msg `
+        -Expected $expectedTarget3 -Actual $plan3.RemoteTarget -DurationMs $t3Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t3Sw.Stop()
+    Register-TestResult -TestId "TC-PARAM-03" -Category "Parameters" `
+        -Name "Empty Remote fallback and empty RemoteSubpath clean handling" `
+        -Description "Validates fallback to cinema-gdrive: without double colon or syntax errors when subpath is empty" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t3Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 1.4: ConfigPath with spaces, unicode and symbols
+$t4Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $complexConfigPath = "C:\Users\Admin\Đường Dẫn Cấu Hình (Rclone)\rclone test [safe].conf"
+    $plan4 = & $mountPath -WhatIf -ConfigPath $complexConfigPath -MountPoint "M:"
+    $t4Sw.Stop()
+
+    $configReported = ($plan4.ConfigProvided -eq $true)
+    $cmdHasConfigArg = ($plan4.ExpectedCommand -match "--config\s+")
+    $cmdContainsPath = ($plan4.ExpectedCommand -match [regex]::Escape($complexConfigPath))
+
+    $p4Passed = ($configReported -and $cmdHasConfigArg -and $cmdContainsPath)
+    $msg = if (-not $p4Passed) { "Config path with spaces/unicode not properly passed into command preview" } else { "" }
+    Register-TestResult -TestId "TC-PARAM-04" -Category "Parameters" `
+        -Name "ConfigPath with spaces, unicode, and symbols in ExpectedCommand" `
+        -Description "Validates proper inclusion of complex config path with spaces and unicode diacritics in expected command" `
+        -Passed $p4Passed -FailureMessage $msg `
+        -Expected "Contains $complexConfigPath" -Actual $plan4.ExpectedCommand -DurationMs $t4Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t4Sw.Stop()
+    Register-TestResult -TestId "TC-PARAM-04" -Category "Parameters" `
+        -Name "ConfigPath with spaces, unicode, and symbols in ExpectedCommand" `
+        -Description "Validates proper inclusion of complex config path with spaces and unicode diacritics in expected command" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t4Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 1.5: MountPoint drive letter variations (case insensitivity and slash variations)
+$t5Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $planLower = & $mountPath -WhatIf -MountPoint "m:"
+    $planSlash = & $mountPath -WhatIf -MountPoint "M:\"
+    $t5Sw.Stop()
+
+    $p5Passed = ($planLower.MountPoint -eq "m:") -and ($planSlash.MountPoint -eq "M:\")
+    Register-TestResult -TestId "TC-PARAM-05" -Category "Parameters" `
+        -Name "MountPoint accepts lowercase and trailing backslash drive letters" `
+        -Description "Validates drive letter formatting robustness for lowercase and trailing backslash" `
+        -Passed $p5Passed -FailureMessage "" `
+        -Expected "m: and M:\" -Actual "$($planLower.MountPoint) and $($planSlash.MountPoint)" `
+        -DurationMs $t5Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t5Sw.Stop()
+    Register-TestResult -TestId "TC-PARAM-05" -Category "Parameters" `
+        -Name "MountPoint accepts lowercase and trailing backslash drive letters" `
+        -Description "Validates drive letter formatting robustness for lowercase and trailing backslash" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t5Sw.Elapsed.TotalMilliseconds
+}
+
+# ==============================================================================
+# SUITE 2: Dry-Run Mode & State Non-Persistence Verification
+# ==============================================================================
+Write-Host "`n--- [SUITE 2] Dry-Run Mode & State Non-Persistence ---" -ForegroundColor Yellow
+
+# Test 2.1: Default invocation without -Execute is Dry-Run
+$t6Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $defaultPlan = & $mountPath
+    $t6Sw.Stop()
+
+    $isDry = ($defaultPlan.Mode -eq "DRY_RUN") -and ($defaultPlan.IsExecute -eq $false)
+    Register-TestResult -TestId "TC-DRY-01" -Category "DryRun" `
+        -Name "Default invocation without -Execute defaults to Dry-Run" `
+        -Description "Confirms that invoking mount_drive without parameters produces a safe dry-run plan" `
+        -Passed $isDry -FailureMessage "Mode is '$($defaultPlan.Mode)', IsExecute is '$($defaultPlan.IsExecute)'" `
+        -Expected "Mode=DRY_RUN, IsExecute=False" -Actual "Mode=$($defaultPlan.Mode), IsExecute=$($defaultPlan.IsExecute)" `
+        -DurationMs $t6Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t6Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-01" -Category "DryRun" `
+        -Name "Default invocation without -Execute defaults to Dry-Run" `
+        -Description "Confirms that invoking mount_drive without parameters produces a safe dry-run plan" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t6Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 2.2: Explicit -WhatIf sets Dry-Run mode
+$t7Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $whatIfPlan = & $mountPath -WhatIf -Remote "cinema-gdrive:"
+    $t7Sw.Stop()
+
+    $isWhatIf = ($whatIfPlan.Mode -eq "DRY_RUN") -and ($whatIfPlan.IsExecute -eq $false)
+    Register-TestResult -TestId "TC-DRY-02" -Category "DryRun" `
+        -Name "Explicit -WhatIf switch produces Dry-Run plan" `
+        -Description "Confirms explicit -WhatIf switch produces DRY_RUN plan" `
+        -Passed $isWhatIf -FailureMessage "Mode is '$($whatIfPlan.Mode)', IsExecute is '$($whatIfPlan.IsExecute)'" `
+        -Expected "Mode=DRY_RUN, IsExecute=False" -Actual "Mode=$($whatIfPlan.Mode), IsExecute=$($whatIfPlan.IsExecute)" `
+        -DurationMs $t7Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t7Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-02" -Category "DryRun" `
+        -Name "Explicit -WhatIf switch produces Dry-Run plan" `
+        -Description "Confirms explicit -WhatIf switch produces DRY_RUN plan" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t7Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 2.3: -WhatIf takes precedence over -Execute
+$t8Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $conflictPlan = & $mountPath -WhatIf -Execute -Remote "cinema-gdrive:"
+    $t8Sw.Stop()
+
+    $whatIfDominates = ($conflictPlan.Mode -eq "DRY_RUN") -and ($conflictPlan.IsExecute -eq $false)
+    Register-TestResult -TestId "TC-DRY-03" -Category "DryRun" `
+        -Name "-WhatIf overrides -Execute to guarantee dry-run safety" `
+        -Description "Validates that passing both -WhatIf and -Execute safely resolves to dry-run" `
+        -Passed $whatIfDominates -FailureMessage "Mode was $($conflictPlan.Mode)" `
+        -Expected "Mode=DRY_RUN" -Actual $conflictPlan.Mode -DurationMs $t8Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t8Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-03" -Category "DryRun" `
+        -Name "-WhatIf overrides -Execute to guarantee dry-run safety" `
+        -Description "Validates that passing both -WhatIf and -Execute safely resolves to dry-run" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t8Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 2.4: Zero processes spawned during Dry-Run
+$t9Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $rcloneProcsBefore = @(Get-Process -Name "rclone" -ErrorAction SilentlyContinue)
+    $null = & $mountPath -WhatIf -Remote "cinema-gdrive:" -RemoteSubpath "DippieMedia"
+    $rcloneProcsAfter = @(Get-Process -Name "rclone" -ErrorAction SilentlyContinue)
+    $t9Sw.Stop()
+
+    $noNewProcesses = ($rcloneProcsAfter.Count -eq $rcloneProcsBefore.Count)
+    Register-TestResult -TestId "TC-DRY-04" -Category "DryRun" `
+        -Name "Dry-Run launches zero processes" `
+        -Description "Confirms no background rclone process is spawned during dry-run evaluation" `
+        -Passed $noNewProcesses -FailureMessage "Process count changed: Before=$($rcloneProcsBefore.Count), After=$($rcloneProcsAfter.Count)" `
+        -Expected "Zero new processes" -Actual "$($rcloneProcsAfter.Count - $rcloneProcsBefore.Count) new processes" `
+        -DurationMs $t9Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t9Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-04" -Category "DryRun" `
+        -Name "Dry-Run launches zero processes" `
+        -Description "Confirms no background rclone process is spawned during dry-run evaluation" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t9Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 2.5: Zero state files written to disk during Dry-Run
+$t10Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $testStateFile = Join-Path ([System.IO.Path]::GetTempPath()) "test-dryrun-state-$([Guid]::NewGuid().ToString('N')).json"
+    $planDry = & $mountPath -WhatIf -StateFile $testStateFile -Remote "cinema-gdrive:"
+    $t10Sw.Stop()
+
+    $fileCreated = Test-Path -Path $testStateFile -PathType Leaf
+    if ($fileCreated) {
+        Remove-Item -Path $testStateFile -Force -ErrorAction SilentlyContinue
+    }
+
+    $stateNotPersisted = (-not $fileCreated)
+    Register-TestResult -TestId "TC-DRY-05" -Category "DryRun" `
+        -Name "Dry-Run does not create or persist state file on disk" `
+        -Description "Confirms that target StateFile path is untouched when operating in dry-run mode" `
+        -Passed $stateNotPersisted -FailureMessage "State file was created at $testStateFile" `
+        -Expected "State file should NOT exist" -Actual "Exists: $fileCreated" `
+        -DurationMs $t10Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t10Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-05" -Category "DryRun" `
+        -Name "Dry-Run does not create or persist state file on disk" `
+        -Description "Confirms that target StateFile path is untouched when operating in dry-run mode" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t10Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 2.6: -AsJson switch produces valid JSON schema in Dry-Run
+$t11Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $jsonOutput = & $mountPath -WhatIf -AsJson -Remote "cinema-gdrive:"
+    $t11Sw.Stop()
+
+    $parsedJson = $null
+    $jsonValid = $false
+    try {
+        $parsedJson = $jsonOutput | ConvertFrom-Json
+        $jsonValid = ($parsedJson -ne $null) -and ($parsedJson.Mode -eq "DRY_RUN")
+    } catch {
+        $jsonValid = $false
+    }
+
+    Register-TestResult -TestId "TC-DRY-06" -Category "DryRun" `
+        -Name "-AsJson switch outputs valid parsable JSON object" `
+        -Description "Verifies strict JSON output formatting for automation pipelines" `
+        -Passed $jsonValid -FailureMessage "Failed to parse JSON string or Mode is not DRY_RUN" `
+        -Expected "Valid JSON with Mode=DRY_RUN" -Actual $(if ($parsedJson) { $parsedJson.Mode } else { "Invalid JSON" }) `
+        -DurationMs $t11Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t11Sw.Stop()
+    Register-TestResult -TestId "TC-DRY-06" -Category "DryRun" `
+        -Name "-AsJson switch outputs valid parsable JSON object" `
+        -Description "Verifies strict JSON output formatting for automation pipelines" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t11Sw.Elapsed.TotalMilliseconds
+}
+
+# ==============================================================================
+# SUITE 3: Occupied Mount Target (Collision Detection)
+# ==============================================================================
+Write-Host "`n--- [SUITE 3] Mount Target Collision Detection ---" -ForegroundColor Yellow
+
+# Test 3.1: Occupied system drive letter C:
+$t12Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $preflightC = & $preflightPath -MountPoint "C:" | ConvertFrom-Json
+    $t12Sw.Stop()
+
+    $cBlocked = ($preflightC.MountTarget.Available -eq $false)
+    $hasReason = ($preflightC.MountTarget.ConflictReason -match "in use|already assigned")
+    $readinessBlocked = ($preflightC.IsReady -eq $false)
+
+    $p12Passed = ($cBlocked -and $hasReason -and $readinessBlocked)
+    $msg = if (-not $p12Passed) { "Drive C: collision was not properly flagged" } else { "" }
+    Register-TestResult -TestId "TC-COLLISION-01" -Category "Collision" `
+        -Name "Occupied system drive letter C: collision detected" `
+        -Description "Validates preflight detects active drive C: as unavailable and includes conflict reason" `
+        -Passed $p12Passed -FailureMessage $msg `
+        -Expected "Available=False, IsReady=False" `
+        -Actual "Available=$($preflightC.MountTarget.Available), Reason=$($preflightC.MountTarget.ConflictReason)" `
+        -DurationMs $t12Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t12Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-01" -Category "Collision" `
+        -Name "Occupied system drive letter C: collision detected" `
+        -Description "Validates preflight detects active drive C: as unavailable and includes conflict reason" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t12Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 3.2: Occupied drive letter with trailing slash C:\
+$t13Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $preflightCSlash = & $preflightPath -MountPoint "C:\" | ConvertFrom-Json
+    $t13Sw.Stop()
+
+    $slashBlocked = ($preflightCSlash.MountTarget.Available -eq $false)
+    Register-TestResult -TestId "TC-COLLISION-02" -Category "Collision" `
+        -Name "Occupied drive letter with trailing slash (C:\) collision detected" `
+        -Description "Validates drive collision detection handles trailing backslash normalization" `
+        -Passed $slashBlocked -FailureMessage "C:\ was reported as Available: $($preflightCSlash.MountTarget.Available)" `
+        -Expected "Available=False" -Actual "Available=$($preflightCSlash.MountTarget.Available)" `
+        -DurationMs $t13Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t13Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-02" -Category "Collision" `
+        -Name "Occupied drive letter with trailing slash (C:\) collision detected" `
+        -Description "Validates drive collision detection handles trailing backslash normalization" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t13Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 3.3: Available unused drive letter detection (e.g. searching Z..E)
+$t14Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $usedLetters = (Get-PSDrive -PSProvider FileSystem | Select-Object -ExpandProperty Name)
+    $availableLetter = $null
+    foreach ($candidate in @("Z", "Y", "X", "W", "V", "U", "T", "S", "R", "Q", "P", "N", "M")) {
+        if ($candidate -notin $usedLetters) {
+            $availableLetter = "$candidate`:"
+            break
+        }
+    }
+
+    if (-not $availableLetter) {
+        throw "Could not find an unused drive letter for collision baseline test"
+    }
+
+    $preflightFree = & $preflightPath -MountPoint $availableLetter | ConvertFrom-Json
+    $t14Sw.Stop()
+
+    $isFree = ($preflightFree.MountTarget.Available -eq $true)
+    Register-TestResult -TestId "TC-COLLISION-03" -Category "Collision" `
+        -Name "Unassigned drive letter ($availableLetter) recognized as available" `
+        -Description "Validates that an unused drive letter passes target collision check" `
+        -Passed $isFree -FailureMessage "Unused drive $availableLetter was flagged as unavailable" `
+        -Expected "Available=True" -Actual "Available=$($preflightFree.MountTarget.Available)" `
+        -DurationMs $t14Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t14Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-03" -Category "Collision" `
+        -Name "Unassigned drive letter recognized as available" `
+        -Description "Validates that an unused drive letter passes target collision check" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t14Sw.Elapsed.TotalMilliseconds
+}
+
+# Test 3.4: Occupied directory collision (non-empty directory)
+$t15Sw = [System.Diagnostics.Stopwatch]::StartNew()
+$tempOccupiedDir = Join-Path ([System.IO.Path]::GetTempPath()) "movie-rcm-collision-dir-$([Guid]::NewGuid().ToString('N'))"
+try {
+    New-Item -ItemType Directory -Path $tempOccupiedDir -Force | Out-Null
+    # Create multiple files to ensure collection count is robust in StrictMode
+    Set-Content -Path (Join-Path $tempOccupiedDir "file1.txt") -Value "payload1"
+    Set-Content -Path (Join-Path $tempOccupiedDir "file2.txt") -Value "payload2"
+
+    $preflightDir = & $preflightPath -MountPoint $tempOccupiedDir | ConvertFrom-Json
+    $t15Sw.Stop()
+
+    $dirBlocked = ($preflightDir.MountTarget.Available -eq $false)
+    $dirReasonMatch = ($preflightDir.MountTarget.ConflictReason -match "not empty")
+
+    $p15Passed = ($dirBlocked -and $dirReasonMatch)
+    $msg = if (-not $p15Passed) { "Non-empty directory was not blocked: $($preflightDir.MountTarget.ConflictReason)" } else { "" }
+    Register-TestResult -TestId "TC-COLLISION-04" -Category "Collision" `
+        -Name "Non-empty directory collision detected" `
+        -Description "Validates that targeting a non-empty directory is blocked as unavailable" `
+        -Passed $p15Passed -FailureMessage $msg `
+        -Expected "Available=False with 'not empty' reason" `
+        -Actual "Available=$($preflightDir.MountTarget.Available), Reason=$($preflightDir.MountTarget.ConflictReason)" `
+        -DurationMs $t15Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t15Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-04" -Category "Collision" `
+        -Name "Non-empty directory collision detected" `
+        -Description "Validates that targeting a non-empty directory is blocked as unavailable" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t15Sw.Elapsed.TotalMilliseconds
+} finally {
+    if (Test-Path -Path $tempOccupiedDir) {
+        Remove-Item -Path $tempOccupiedDir -Recurse -Force -ErrorAction SilentlyContinue
+    }
+}
+
+# Test 3.5: Regular file passed as mount target
+$t16Sw = [System.Diagnostics.Stopwatch]::StartNew()
+$tempTargetFile = Join-Path ([System.IO.Path]::GetTempPath()) "movie-rcm-file-target-$([Guid]::NewGuid().ToString('N')).txt"
+try {
+    Set-Content -Path $tempTargetFile -Value "regular file content"
+    $preflightFileTarget = & $preflightPath -MountPoint $tempTargetFile | ConvertFrom-Json
+    $t16Sw.Stop()
+
+    $fileBlocked = ($preflightFileTarget.MountTarget.Available -eq $false)
+    $fileReasonMatch = ($preflightFileTarget.MountTarget.ConflictReason -match "regular file, not a directory")
+
+    $p16Passed = ($fileBlocked -and $fileReasonMatch)
+    $msg = if (-not $p16Passed) { "Regular file target was not rejected: $($preflightFileTarget.MountTarget.ConflictReason)" } else { "" }
+    Register-TestResult -TestId "TC-COLLISION-05" -Category "Collision" `
+        -Name "Regular file collision rejected as invalid mount target" `
+        -Description "Validates preflight rejects existing regular files passed as directory mount targets" `
+        -Passed $p16Passed -FailureMessage $msg `
+        -Expected "Available=False with regular file error" `
+        -Actual "Available=$($preflightFileTarget.MountTarget.Available), Reason=$($preflightFileTarget.MountTarget.ConflictReason)" `
+        -DurationMs $t16Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t16Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-05" -Category "Collision" `
+        -Name "Regular file collision rejected as invalid mount target" `
+        -Description "Validates preflight rejects existing regular files passed as directory mount targets" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t16Sw.Elapsed.TotalMilliseconds
+} finally {
+    if (Test-Path -Path $tempTargetFile) {
+        Remove-Item -Path $tempTargetFile -Force -ErrorAction SilentlyContinue
+    }
+}
+
+# Test 3.6: Mount collision surfaced in mount_drive dry-run blockers
+$t17Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $mountPlanC = & $mountPath -WhatIf -MountPoint "C:"
+    $t17Sw.Stop()
+
+    $planBlocked = ($mountPlanC.PreflightIsReady -eq $false)
+    $blockersJoined = ($mountPlanC.PreflightBlockers -join "; ")
+    $hasMountBlocker = ($blockersJoined -match "Mount target 'C:' is unavailable")
+
+    $p17Passed = ($planBlocked -and $hasMountBlocker)
+    Register-TestResult -TestId "TC-COLLISION-06" -Category "Collision" `
+        -Name "mount_drive surfaces mount collision in PreflightBlockers" `
+        -Description "Validates that mount_drive plan surfaces collision reasons in PreflightBlockers list" `
+        -Passed $p17Passed -FailureMessage "Blockers missing collision notice: $blockersJoined" `
+        -Expected "PreflightIsReady=False with collision in PreflightBlockers" `
+        -Actual "PreflightIsReady=$($mountPlanC.PreflightIsReady), Blockers=$blockersJoined" `
+        -DurationMs $t17Sw.Elapsed.TotalMilliseconds
+} catch {
+    $t17Sw.Stop()
+    Register-TestResult -TestId "TC-COLLISION-06" -Category "Collision" `
+        -Name "mount_drive surfaces mount collision in PreflightBlockers" `
+        -Description "Validates that mount_drive plan surfaces collision reasons in PreflightBlockers list" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t17Sw.Elapsed.TotalMilliseconds
+}
+
+# ==============================================================================
+# SUITE 4: Standard Baseline Streaming Flags Verification
+# ==============================================================================
+Write-Host "`n--- [SUITE 4] Baseline Streaming Flags Verification ---" -ForegroundColor Yellow
+
+$t18Sw = [System.Diagnostics.Stopwatch]::StartNew()
+try {
+    $planFlags = & $mountPath -WhatIf -Remote "cinema-gdrive:" -RemoteSubpath "DippieMedia" -MountPoint "M:"
+    $t18Sw.Stop()
+
+    $flagsList = $planFlags.BaselineFlags
+    $cmdStr    = [string]$planFlags.ExpectedCommand
+    $flagStr   = [string]$planFlags.BaselineFlagsString
+
+    # 1. --read-only
+    $hasReadOnly = ($flagsList -contains "--read-only") -and ($cmdStr -match "--read-only")
+    Register-TestResult -TestId "TC-FLAGS-01" -Category "StreamingFlags" `
+        -Name "Enforce --read-only baseline flag" `
+        -Description "Validates --read-only flag is present in flags list and command line" `
+        -Passed $hasReadOnly -FailureMessage "Missing --read-only flag" `
+        -Expected "--read-only" -Actual $hasReadOnly -DurationMs 1
+
+    # 2. --vfs-cache-mode off
+    $vfsCacheIdx = [array]::IndexOf($flagsList, "--vfs-cache-mode")
+    $hasVfsOff = ($vfsCacheIdx -ge 0) -and ($flagsList[$vfsCacheIdx + 1] -eq "off") -and ($cmdStr -match "--vfs-cache-mode\s+off")
+    Register-TestResult -TestId "TC-FLAGS-02" -Category "StreamingFlags" `
+        -Name "Enforce --vfs-cache-mode off (Direct RAM streaming)" `
+        -Description "Validates cache mode is strictly set to off for pure RAM streaming without local caching" `
+        -Passed $hasVfsOff -FailureMessage "Missing or incorrect --vfs-cache-mode off" `
+        -Expected "--vfs-cache-mode off" -Actual $hasVfsOff -DurationMs 1
+
+    # 3. --buffer-size 32M
+    $bufIdx = [array]::IndexOf($flagsList, "--buffer-size")
+    $hasBuf32M = ($bufIdx -ge 0) -and ($flagsList[$bufIdx + 1] -eq "32M") -and ($cmdStr -match "--buffer-size\s+32M")
+    Register-TestResult -TestId "TC-FLAGS-03" -Category "StreamingFlags" `
+        -Name "Enforce --buffer-size 32M (RFC 9110 compliant RAM buffer)" `
+        -Description "Validates RAM read buffer size is bounded to 32MB" `
+        -Passed $hasBuf32M -FailureMessage "Missing or incorrect --buffer-size 32M" `
+        -Expected "--buffer-size 32M" -Actual $hasBuf32M -DurationMs 1
+
+    # 4. --vfs-read-chunk-size 8M
+    $chunkIdx = [array]::IndexOf($flagsList, "--vfs-read-chunk-size")
+    $hasChunk8M = ($chunkIdx -ge 0) -and ($flagsList[$chunkIdx + 1] -eq "8M") -and ($cmdStr -match "--vfs-read-chunk-size\s+8M")
+    Register-TestResult -TestId "TC-FLAGS-04" -Category "StreamingFlags" `
+        -Name "Enforce --vfs-read-chunk-size 8M (Initial fast seek chunk)" `
+        -Description "Validates initial read chunk size is set to 8MB" `
+        -Passed $hasChunk8M -FailureMessage "Missing or incorrect --vfs-read-chunk-size 8M" `
+        -Expected "--vfs-read-chunk-size 8M" -Actual $hasChunk8M -DurationMs 1
+
+    # 5. --vfs-read-chunk-size-limit 32M
+    $limitIdx = [array]::IndexOf($flagsList, "--vfs-read-chunk-size-limit")
+    $hasLimit32M = ($limitIdx -ge 0) -and ($flagsList[$limitIdx + 1] -eq "32M") -and ($cmdStr -match "--vfs-read-chunk-size-limit\s+32M")
+    Register-TestResult -TestId "TC-FLAGS-05" -Category "StreamingFlags" `
+        -Name "Enforce --vfs-read-chunk-size-limit 32M (Maximum chunk cap)" `
+        -Description "Validates chunk size limit does not exceed 32MB cap" `
+        -Passed $hasLimit32M -FailureMessage "Missing or incorrect --vfs-read-chunk-size-limit 32M" `
+        -Expected "--vfs-read-chunk-size-limit 32M" -Actual $hasLimit32M -DurationMs 1
+
+    # 6. --vfs-read-chunk-streams 0
+    $streamIdx = [array]::IndexOf($flagsList, "--vfs-read-chunk-streams")
+    $hasStreams0 = ($streamIdx -ge 0) -and ($flagsList[$streamIdx + 1] -eq "0") -and ($cmdStr -match "--vfs-read-chunk-streams\s+0")
+    Register-TestResult -TestId "TC-FLAGS-06" -Category "StreamingFlags" `
+        -Name "Enforce --vfs-read-chunk-streams 0 (Sequential stream isolation)" `
+        -Description "Validates chunk streams is disabled (0) to eliminate multi-range head races" `
+        -Passed $hasStreams0 -FailureMessage "Missing or incorrect --vfs-read-chunk-streams 0" `
+        -Expected "--vfs-read-chunk-streams 0" -Actual $hasStreams0 -DurationMs 1
+
+    # 7. Auxiliary metadata performance flags
+    $hasDirCache = ($cmdStr -match "--dir-cache-time\s+72h")
+    $hasPollInt  = ($cmdStr -match "--poll-interval\s+15s")
+    $hasAttrTime = ($cmdStr -match "--attr-timeout\s+1s")
+    $pAuxPassed  = ($hasDirCache -and $hasPollInt -and $hasAttrTime)
+    Register-TestResult -TestId "TC-FLAGS-07" -Category "StreamingFlags" `
+        -Name "Enforce directory and attribute cache flags (72h dir-cache, 15s poll, 1s attr)" `
+        -Description "Validates performance metadata caching flags for low API request overhead" `
+        -Passed $pAuxPassed -FailureMessage "Missing auxiliary caching flags in command string" `
+        -Expected "dir-cache 72h, poll-interval 15s, attr-timeout 1s" -Actual $pAuxPassed -DurationMs 1
+} catch {
+    $t18Sw.Stop()
+    Register-TestResult -TestId "TC-FLAGS-00" -Category "StreamingFlags" `
+        -Name "Baseline streaming flags extraction" `
+        -Description "Validates error-free execution of baseline flag extraction" `
+        -Passed $false -FailureMessage $_.Exception.Message -DurationMs $t18Sw.Elapsed.TotalMilliseconds
+}
+
+# ==============================================================================
+# EVIDENCE EXPORT & SUMMARY
+# ==============================================================================
+$suiteStopwatch.Stop()
+$totalCount  = $results.Count
+$passedCount = @($results | Where-Object { $_.Passed }).Count
+$failedCount = @($results | Where-Object { -not $_.Passed }).Count
+$durationSec = [math]::Round($suiteStopwatch.Elapsed.TotalSeconds, 3)
+
+Write-Host "`n================================================================================" -ForegroundColor Cyan
+Write-Host " COMPREHENSIVE TOOLKIT VERIFICATION SUMMARY" -ForegroundColor Cyan
+Write-Host " Total Tests : $totalCount"
+Write-Host " Passed      : $passedCount" -ForegroundColor $(if ($passedCount -eq $totalCount) { "Green" } else { "Yellow" })
+Write-Host " Failed      : $failedCount" -ForegroundColor $(if ($failedCount -eq 0) { "Green" } else { "Red" })
+Write-Host " Duration    : $durationSec seconds"
+Write-Host "================================================================================" -ForegroundColor Cyan
+
+# Update or create shared evidence JSON
+try {
+    $evidenceDir = Split-Path -Path $EvidencePath -Parent
+    if (-not (Test-Path -Path $evidenceDir -PathType Container)) {
+        New-Item -ItemType Directory -Path $evidenceDir -Force | Out-Null
+    }
+
+    $evidenceDoc = $null
+    if (Test-Path -Path $EvidencePath -PathType Leaf) {
+        try {
+            $rawJson = Get-Content -Path $EvidencePath -Raw -Encoding UTF8
+            if ($rawJson) { $evidenceDoc = $rawJson | ConvertFrom-Json }
+        } catch {}
+    }
+
+    if (-not $evidenceDoc) {
+        $evidenceDoc = [PSCustomObject]@{
+            timestamp       = [DateTime]::UtcNow.ToString("o")
+            agent           = "Agent E (Windows Toolkit Verification Engineer)"
+            mission         = "DRIVE-01"
+            environment     = [PSCustomObject]@{
+                os                  = [System.Environment]::OSVersion.VersionString
+                powershell_version  = $PSVersionTable.PSVersion.ToString()
+                powershell_edition  = $PSVersionTable.PSEdition
+                user                = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
+                machine             = $env:COMPUTERNAME
+            }
+            overall_status  = "PENDING"
+            summary         = [PSCustomObject]@{
+                total_tests     = 0
+                passed_tests    = 0
+                failed_tests    = 0
+                success_rate    = "0%"
+            }
+            suites          = [PSCustomObject]@{}
+        }
+    }
+
+    # Attach this suite results
+    $suiteObj = [PSCustomObject]@{
+        suite_name       = "Comprehensive Toolkit Verification"
+        script           = "scripts/drive-tests/test_drive_toolkit_comprehensive.ps1"
+        status           = $(if ($failedCount -eq 0) { "PASSED" } else { "FAILED" })
+        total            = $totalCount
+        passed           = $passedCount
+        failed           = $failedCount
+        duration_seconds = $durationSec
+        tests            = $results
+    }
+
+    if (-not $evidenceDoc.suites) {
+        $evidenceDoc | Add-Member -MemberType NoteProperty -Name "suites" -Value ([PSCustomObject]@{})
+    }
+    $evidenceDoc.suites | Add-Member -MemberType NoteProperty -Name "comprehensive_toolkit" -Value $suiteObj -Force
+
+    # Recalculate summary across all recorded suites
+    $allTotal = 0
+    $allPassed = 0
+    $allFailed = 0
+    foreach ($p in $evidenceDoc.suites.PSObject.Properties) {
+        if ($p.Value) {
+            $allTotal  += [int]$p.Value.total
+            $allPassed += [int]$p.Value.passed
+            $allFailed += [int]$p.Value.failed
+        }
+    }
+
+    $rate = if ($allTotal -gt 0) { "$([math]::Round(($allPassed / $allTotal) * 100, 1))%" } else { "0%" }
+    $evidenceDoc.summary.total_tests  = $allTotal
+    $evidenceDoc.summary.passed_tests = $allPassed
+    $evidenceDoc.summary.failed_tests = $allFailed
+    $evidenceDoc.summary.success_rate = $rate
+    $evidenceDoc.overall_status       = if ($allFailed -eq 0) { "PASSED" } else { "FAILED" }
+    $evidenceDoc.timestamp            = [DateTime]::UtcNow.ToString("o")
+
+    $evidenceDoc | ConvertTo-Json -Depth 10 | Set-Content -Path $EvidencePath -Encoding UTF8
+    Write-Host "Evidence JSON successfully updated at: $EvidencePath" -ForegroundColor Green
+} catch {
+    Write-Warning "Failed to write evidence JSON: $($_.Exception.Message)"
+}
+
+if ($failedCount -gt 0) {
+    if (-not $NoExit) { exit 1 }
+} else {
+    if (-not $NoExit) { exit 0 }
+}
diff --git a/scripts/drive/mount_drive.ps1 b/scripts/drive/mount_drive.ps1
new file mode 100644
index 0000000..f68fd2a
--- /dev/null
+++ b/scripts/drive/mount_drive.ps1
@@ -0,0 +1,276 @@
+<#
+.SYNOPSIS
+    Mounts a Google Drive remote on Windows using rclone and WinFsp.
+.DESCRIPTION
+    Implements safe baseline Google Drive mounting on Windows.
+    Default mode is dry-run (-WhatIf or omitting -Execute) to plan and validate flags.
+    Enforces baseline streaming flags: read-only, cache-off, 32M buffer, 8M initial chunk.
+    When -Execute is passed, runs preflight verification first and persists PID & process state to JSON.
+.PARAMETER Remote
+    The rclone remote name (e.g. "cinema-gdrive:" or "gdrive").
+.PARAMETER RemoteSubpath
+    Subpath on the remote. Default is "DippieMedia".
+.PARAMETER MountPoint
+    Windows mount target (drive letter like "M:" or empty NTFS directory). Default is "M:".
+.PARAMETER ConfigPath
+    Optional explicit path to rclone.conf.
+.PARAMETER RclonePath
+    Optional explicit path to rclone executable.
+.PARAMETER StateFile
+    Path to save runtime process state JSON. Defaults to $env:TEMP\movie-rcm-drive-mount.json.
+.PARAMETER LogFile
+    Optional log file path for rclone logging.
+.PARAMETER WhatIf
+    Explicitly request a dry-run plan without mounting.
+.PARAMETER Execute
+    Execute the mount process in background.
+.PARAMETER AsJson
+    Output plan / result strictly as JSON string.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $false)]
+    [string]$Remote,
+
+    [Parameter(Mandatory = $false)]
+    [string]$RemoteSubpath = "DippieMedia",
+
+    [Parameter(Mandatory = $false)]
+    [string]$MountPoint = "M:",
+
+    [Parameter(Mandatory = $false)]
+    [string]$ConfigPath,
+
+    [Parameter(Mandatory = $false)]
+    [string]$RclonePath,
+
+    [Parameter(Mandatory = $false)]
+    [string]$StateFile,
+
+    [Parameter(Mandatory = $false)]
+    [string]$LogFile,
+
+    [switch]$WhatIf,
+    [switch]$Execute,
+    [switch]$AsJson
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+# Resolve state file location
+if (-not $StateFile) {
+    $tempDir = if ($env:TEMP) { $env:TEMP } else { [System.IO.Path]::GetTempPath() }
+    $StateFile = Join-Path $tempDir "movie-rcm-drive-mount.json"
+}
+
+# Resolve remote target path
+$effectiveRemote = $Remote
+if (-not $effectiveRemote) {
+    # Default placeholder for preview / dry-run mode
+    $effectiveRemote = "cinema-gdrive:"
+}
+
+$remoteTarget = ""
+if ($effectiveRemote.EndsWith(":")) {
+    if ($RemoteSubpath) {
+        $remoteTarget = "$($effectiveRemote)$($RemoteSubpath)"
+    } else {
+        $remoteTarget = $effectiveRemote
+    }
+} else {
+    if ($RemoteSubpath) {
+        $remoteTarget = "$($effectiveRemote):$($RemoteSubpath)"
+    } else {
+        $remoteTarget = "$($effectiveRemote):"
+    }
+}
+
+# Baseline streaming flags (RFC 9110 HTTP Range compliant, RAM buffer 32M, cache-off)
+$baselineFlags = @(
+    "--read-only",
+    "--vfs-cache-mode", "off",
+    "--buffer-size", "32M",
+    "--vfs-read-chunk-size", "8M",
+    "--vfs-read-chunk-size-limit", "32M",
+    "--vfs-read-chunk-streams", "0",
+    "--dir-cache-time", "72h",
+    "--poll-interval", "15s",
+    "--attr-timeout", "1s"
+)
+
+# Baseline flags string representation
+$baselineFlagsString = "--read-only --vfs-cache-mode off --buffer-size 32M --vfs-read-chunk-size 8M --vfs-read-chunk-size-limit 32M --vfs-read-chunk-streams 0 --dir-cache-time 72h --poll-interval 15s --attr-timeout 1s"
+
+# Locate preflight script
+$preflightScript = Join-Path $PSScriptRoot "preflight_drive.ps1"
+if (-not (Test-Path -Path $preflightScript -PathType Leaf -ErrorAction SilentlyContinue)) {
+    throw "Preflight script not found at expected path: $preflightScript"
+}
+
+# Determine execution mode (Dry-run by default unless -Execute is specified AND -WhatIf is not)
+$isDryRun = (-not $Execute) -or $WhatIf
+
+if ($isDryRun) {
+    # Perform preflight evaluation in dry-run mode
+    $preflightJsonRaw = & $preflightScript -MountPoint $MountPoint -RclonePath $RclonePath -ConfigPath $ConfigPath
+    $preflightObj = $null
+    try {
+        $preflightObj = $preflightJsonRaw | ConvertFrom-Json
+    } catch {
+        # Fallback if json parse fails
+    }
+
+    $rcloneCmd = "rclone"
+    if ($preflightObj -and $preflightObj.Rclone -and $preflightObj.Rclone.ExecutablePath) {
+        $rcloneCmd = $preflightObj.Rclone.ExecutablePath
+    } elseif ($RclonePath) {
+        $rcloneCmd = $RclonePath
+    }
+
+    $argPreview = @("mount", $remoteTarget, $MountPoint) + $baselineFlags
+    if ($ConfigPath) {
+        $argPreview += @("--config", $ConfigPath)
+    }
+    if ($LogFile) {
+        $argPreview += @("--log-file", $LogFile, "--log-level", "INFO")
+    }
+
+    $expectedCommand = "$rcloneCmd " + ($argPreview -join " ")
+
+    $plan = [PSCustomObject]@{
+        Timestamp           = [DateTime]::UtcNow.ToString("o")
+        Mode                = "DRY_RUN"
+        IsExecute           = $false
+        Remote              = $effectiveRemote
+        RemoteSubpath       = $RemoteSubpath
+        RemoteTarget        = $remoteTarget
+        MountPoint          = $MountPoint
+        BaselineFlags       = $baselineFlags
+        BaselineFlagsString = $baselineFlagsString
+        ExpectedCommand     = $expectedCommand
+        StateFile           = $StateFile
+        PreflightIsReady    = if ($preflightObj) { [bool]$preflightObj.IsReady } else { $false }
+        PreflightStatus     = if ($preflightObj) { [string]$preflightObj.Status } else { "UNKNOWN" }
+        PreflightBlockers   = if ($preflightObj) { $preflightObj.BlockReasons } else { @() }
+        ConfigProvided      = [bool]$ConfigPath
+        LogFile             = $LogFile
+        Guidance            = "Dry-run plan created. To mount Google Drive, install prerequisites if needed and invoke with '-Execute'."
+    }
+
+    if ($AsJson) {
+        $plan | ConvertTo-Json -Depth 6
+    } else {
+        # Return structured object to pipeline
+        $plan
+    }
+    return
+}
+
+# ================= EXECUTION MODE (-Execute) =================
+
+if (-not $Remote) {
+    throw "Parameter -Remote is required when running with -Execute. Example: -Remote 'cinema-gdrive:'"
+}
+
+# 1. Run Preflight verification
+$preflightJsonRaw = & $preflightScript -MountPoint $MountPoint -RclonePath $RclonePath -ConfigPath $ConfigPath
+$preflightObj = $preflightJsonRaw | ConvertFrom-Json
+
+if (-not $preflightObj.IsReady) {
+    $blockers = ($preflightObj.BlockReasons -join "; ")
+    throw "Preflight verification failed. Drive cannot be mounted: $blockers"
+}
+
+$rcloneExe = $preflightObj.Rclone.ExecutablePath
+if (-not $rcloneExe) {
+    throw "Rclone executable not resolved by preflight check."
+}
+
+# 2. Check existing state file for running mount
+if (Test-Path -Path $StateFile -PathType Leaf -ErrorAction SilentlyContinue) {
+    try {
+        $existingState = Get-Content -Path $StateFile -Raw -Encoding UTF8 | ConvertFrom-Json
+        if ($existingState -and $existingState.pid) {
+            $existingProc = Get-Process -Id $existingState.pid -ErrorAction SilentlyContinue
+            if ($existingProc -and ($existingProc.ProcessName -ieq "rclone")) {
+                throw "A previous rclone mount process (PID $($existingState.pid)) is currently running for mount point '$($existingState.mountPoint)'. Use stop_drive.ps1 before remounting."
+            }
+        }
+    } catch [System.Management.Automation.ItemNotFoundException] {
+        # File disappeared, proceed
+    }
+}
+
+# 3. Assemble arguments for rclone mount
+$mountArgs = @(
+    "mount",
+    $remoteTarget,
+    $MountPoint,
+    "--read-only",
+    "--vfs-cache-mode", "off",
+    "--buffer-size", "32M",
+    "--vfs-read-chunk-size", "8M",
+    "--vfs-read-chunk-size-limit", "32M",
+    "--vfs-read-chunk-streams", "0",
+    "--dir-cache-time", "72h",
+    "--poll-interval", "15s",
+    "--attr-timeout", "1s"
+)
+
+if ($ConfigPath) {
+    $mountArgs += @("--config", $ConfigPath)
+}
+if ($LogFile) {
+    $mountArgs += @("--log-file", $LogFile, "--log-level", "INFO")
+}
+
+# 4. Launch hidden background rclone process
+$proc = Start-Process -FilePath $rcloneExe -ArgumentList $mountArgs -WindowStyle Hidden -PassThru
+
+if (-not $proc) {
+    throw "Failed to start rclone process."
+}
+
+# Short stabilization check (1 second) to detect immediate startup crash
+Start-Sleep -Seconds 1
+if ($proc.HasExited) {
+    throw "Rclone process exited immediately with exit code $($proc.ExitCode). Check config and logs for details."
+}
+
+# 5. Save process state to JSON
+$currentProc = Get-Process -Id $PID
+$stateRecord = [PSCustomObject]@{
+    pid            = $proc.Id
+    processName    = $proc.ProcessName
+    startTime      = $proc.StartTime.ToString("o")
+    executablePath = $rcloneExe
+    mountPoint     = $MountPoint
+    remoteTarget   = $remoteTarget
+    flags          = $baselineFlags
+    commandLine    = "$rcloneExe " + ($mountArgs -join " ")
+    stateFile      = $StateFile
+    logFile        = $LogFile
+    sessionId      = $currentProc.SessionId
+    user           = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
+    createdAt      = [DateTime]::UtcNow.ToString("o")
+    status         = "RUNNING"
+}
+
+$stateRecord | ConvertTo-Json -Depth 6 | Set-Content -Path $StateFile -Encoding UTF8
+
+$result = [PSCustomObject]@{
+    Success      = $true
+    Status       = "MOUNTED"
+    PID          = $proc.Id
+    MountPoint   = $MountPoint
+    RemoteTarget = $remoteTarget
+    StateFile    = $StateFile
+    Message      = "Rclone mount started successfully in background with PID $($proc.Id)."
+}
+
+if ($AsJson) {
+    $result | ConvertTo-Json -Depth 5
+} else {
+    $result
+}
diff --git a/scripts/drive/preflight_drive.ps1 b/scripts/drive/preflight_drive.ps1
new file mode 100644
index 0000000..e55a6bc
--- /dev/null
+++ b/scripts/drive/preflight_drive.ps1
@@ -0,0 +1,443 @@
+<#
+.SYNOPSIS
+    Preflight verification for Google Drive mount tooling on Windows.
+.DESCRIPTION
+    Inspects host OS, rclone executable, WinFsp installation, mount target collision,
+    user session isolation, RAM and disk capacity.
+    Outputs structured JSON. Does NOT log or leak config secrets or tokens.
+.PARAMETER MountPoint
+    Target drive letter (e.g. "M:") or NTFS directory path. Default is "M:".
+.PARAMETER RclonePath
+    Optional explicit path to rclone.exe. If omitted, PATH and common install locations are checked.
+.PARAMETER ConfigPath
+    Optional explicit path to rclone.conf. Validates file existence and size without dumping contents.
+.OUTPUTS
+    Structured JSON object containing health and readiness assessment.
+#>
+[CmdletBinding()]
+param(
+    [string]$MountPoint = "M:",
+    [string]$RclonePath,
+    [string]$ConfigPath
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+function Test-WinFspInstalled {
+    $result = [PSCustomObject]@{
+        Installed      = $false
+        RegistryFound  = $false
+        RegistryPath   = $null
+        InstallDir     = $null
+        Version        = $null
+        DllFound       = $false
+        DllPaths       = @()
+        DriverLoaded   = $false
+        DetectionNotes = @()
+    }
+
+    # 1. Registry verification
+    $regCandidates = @(
+        "HKLM:\SOFTWARE\WinFsp",
+        "HKLM:\SOFTWARE\WOW6432Node\WinFsp"
+    )
+    foreach ($regPath in $regCandidates) {
+        if (Test-Path -Path $regPath -ErrorAction SilentlyContinue) {
+            $result.RegistryFound = $true
+            $result.RegistryPath = $regPath
+            try {
+                $item = Get-ItemProperty -Path $regPath -ErrorAction SilentlyContinue
+                if ($item) {
+                    if ($item.InstallDir) { $result.InstallDir = [string]$item.InstallDir }
+                    if ($item.Version) { $result.Version = [string]$item.Version }
+                }
+            } catch {
+                # Ignore read error
+            }
+            $result.DetectionNotes += "Registry key verified at $regPath"
+            break
+        }
+    }
+
+    # 2. File and DLL verification (System32 & Program Files)
+    $dllCandidates = @()
+    if ($env:SystemRoot) {
+        $dllCandidates += (Join-Path $env:SystemRoot "System32\winfsp-x64.dll")
+        $dllCandidates += (Join-Path $env:SystemRoot "System32\winfsp-x86.dll")
+        $dllCandidates += (Join-Path $env:SystemRoot "System32\winfsp-a64.dll")
+    }
+    if ($env:ProgramFiles) {
+        $dllCandidates += (Join-Path $env:ProgramFiles "WinFsp\bin\winfsp-x64.dll")
+        $dllCandidates += (Join-Path $env:ProgramFiles "WinFsp\bin\winfsp-a64.dll")
+    }
+    $programFilesX86 = ${env:ProgramFiles(x86)}
+    if ($programFilesX86) {
+        $dllCandidates += (Join-Path $programFilesX86 "WinFsp\bin\winfsp-x86.dll")
+    }
+    if ($result.InstallDir) {
+        $dllCandidates += (Join-Path $result.InstallDir "bin\winfsp-x64.dll")
+        $dllCandidates += (Join-Path $result.InstallDir "bin\winfsp-x86.dll")
+    }
+
+    $foundDlls = @()
+    foreach ($dll in ($dllCandidates | Select-Object -Unique)) {
+        if ($dll -and (Test-Path -Path $dll -PathType Leaf -ErrorAction SilentlyContinue)) {
+            $foundDlls += $dll
+        }
+    }
+    if ($foundDlls.Count -gt 0) {
+        $result.DllFound = $true
+        $result.DllPaths = $foundDlls
+        $result.DetectionNotes += "WinFsp DLL verified: $($foundDlls -join '; ')"
+    }
+
+    # 3. Filter driver verification via fltmc
+    try {
+        $fltCmd = Get-Command "fltmc.exe" -ErrorAction SilentlyContinue
+        if ($fltCmd) {
+            $fltOutput = & $fltCmd.Source "filters" 2>&1
+            if ($LASTEXITCODE -eq 0 -and $fltOutput) {
+                $match = $fltOutput | Where-Object { $_ -match "\b(winfsp|fsp)\b" }
+                if ($match) {
+                    $result.DriverLoaded = $true
+                    $result.DetectionNotes += "WinFsp mini-filter driver active in fltmc filters"
+                }
+            } else {
+                $result.DetectionNotes += "fltmc filters requires elevated privileges or returned code $LASTEXITCODE"
+            }
+        }
+    } catch {
+        $result.DetectionNotes += "fltmc filter check skipped: $($_.Exception.Message)"
+    }
+
+    # Composite decision
+    if ($result.RegistryFound -or $result.DllFound -or $result.DriverLoaded) {
+        $result.Installed = $true
+    }
+
+    return $result
+}
+
+function Find-RcloneExecutable {
+    param([string]$ExplicitPath)
+
+    if ($ExplicitPath) {
+        if (Test-Path -Path $ExplicitPath -PathType Leaf -ErrorAction SilentlyContinue) {
+            return (Resolve-Path -Path $ExplicitPath).Path
+        }
+        return $null
+    }
+
+    # Check PATH
+    $cmd = Get-Command "rclone.exe" -ErrorAction SilentlyContinue
+    if (-not $cmd) {
+        $cmd = Get-Command "rclone" -ErrorAction SilentlyContinue
+    }
+    if ($cmd -and $cmd.Source) {
+        return $cmd.Source
+    }
+
+    # Common installation locations on Windows
+    $candidates = @()
+    if ($env:ProgramFiles) {
+        $candidates += (Join-Path $env:ProgramFiles "Rclone\rclone.exe")
+        $candidates += (Join-Path $env:ProgramFiles "rclone\rclone.exe")
+    }
+    if ($env:LOCALAPPDATA) {
+        $candidates += (Join-Path $env:LOCALAPPDATA "Programs\rclone\rclone.exe")
+        $candidates += (Join-Path $env:LOCALAPPDATA "Programs\Rclone\rclone.exe")
+    }
+    $candidates += "C:\rclone\rclone.exe"
+    $candidates += "C:\Tools\rclone\rclone.exe"
+    if ($env:ChocolateyInstall) {
+        $candidates += (Join-Path $env:ChocolateyInstall "bin\rclone.exe")
+    }
+    if ($env:USERPROFILE) {
+        $candidates += (Join-Path $env:USERPROFILE "scoop\shims\rclone.exe")
+    }
+
+    foreach ($candidate in $candidates) {
+        if (Test-Path -Path $candidate -PathType Leaf -ErrorAction SilentlyContinue) {
+            return (Resolve-Path -Path $candidate).Path
+        }
+    }
+
+    return $null
+}
+
+function Test-MountPointAvailable {
+    param([string]$Target)
+
+    $res = [PSCustomObject]@{
+        Target           = $Target
+        IsDriveLetter    = $false
+        IsDirectory      = $false
+        Available        = $true
+        ConflictReason   = $null
+        FileSystem       = $null
+    }
+
+    # Check if target is a drive letter (e.g. "M:" or "M:\")
+    if ($Target -match "^[A-Za-z]:?\\?$") {
+        $res.IsDriveLetter = $true
+        $driveLetter = $Target.Substring(0, 1).ToUpper()
+        $drivePrefix = "$($driveLetter):"
+
+        # Check PowerShell drives
+        $psDrive = Get-PSDrive -Name $driveLetter -ErrorAction SilentlyContinue
+        if ($psDrive) {
+            $res.Available = $false
+            $res.ConflictReason = "Drive letter '$drivePrefix' is in use (Provider: $($psDrive.Provider.Name), Root: $($psDrive.Root))."
+            return $res
+        }
+
+        # Check Windows logical drives via .NET DriveInfo
+        try {
+            $drives = [System.IO.DriveInfo]::GetDrives()
+            $matching = $drives | Where-Object { $_.Name.StartsWith($drivePrefix, [System.StringComparison]::OrdinalIgnoreCase) }
+            if ($matching) {
+                $res.Available = $false
+                $res.ConflictReason = "Drive letter '$drivePrefix' is already assigned (Type: $($matching.DriveType))."
+                return $res
+            }
+        } catch {
+            # Ignore drive enumeration error
+        }
+
+        $res.Available = $true
+        return $res
+    }
+
+    # Otherwise treat target as an NTFS directory path
+    $res.IsDirectory = $true
+    if (Test-Path -Path $Target -ErrorAction SilentlyContinue) {
+        $item = Get-Item -Path $Target -ErrorAction SilentlyContinue
+        if ($item -and -not $item.PSIsContainer) {
+            $res.Available = $false
+            $res.ConflictReason = "Mount point '$Target' exists and is a regular file, not a directory."
+            return $res
+        }
+
+        # Check if directory is empty (rclone directory mount requires empty directory)
+        $children = Get-ChildItem -Path $Target -Force -ErrorAction SilentlyContinue
+        if ($children -and $children.Count -gt 0) {
+            $res.Available = $false
+            $res.ConflictReason = "Mount directory '$Target' is not empty ($($children.Count) items found)."
+            return $res
+        }
+    }
+
+    # Check filesystem type of target volume (must be NTFS for WinFsp directory mount)
+    try {
+        $fullPath = [System.IO.Path]::GetFullPath($Target)
+        $root = [System.IO.Path]::GetPathRoot($fullPath)
+        $driveInfo = [System.IO.DriveInfo]::new($root)
+        $res.FileSystem = $driveInfo.DriveFormat
+        if ($driveInfo.DriveFormat -ne "NTFS") {
+            $res.Available = $false
+            $res.ConflictReason = "Directory mount target root ($root) filesystem is '$($driveInfo.DriveFormat)'. WinFsp directory mounts require NTFS."
+            return $res
+        }
+    } catch {
+        # Fallback if DriveInfo fails
+    }
+
+    return $res
+}
+
+function Get-UserSessionInfo {
+    $currentIdentity = [System.Security.Principal.WindowsIdentity]::GetCurrent()
+    $principal = [System.Security.Principal.WindowsPrincipal]::new($currentIdentity)
+    $isElevated = $principal.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)
+    $currentProc = Get-Process -Id $PID
+
+    # Check EnableLinkedConnections in registry (relevant for elevated vs non-elevated drive mapping)
+    $linkedConnections = $null
+    $regPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
+    if (Test-Path -Path $regPath -ErrorAction SilentlyContinue) {
+        try {
+            $sysPol = Get-ItemProperty -Path $regPath -Name "EnableLinkedConnections" -ErrorAction SilentlyContinue
+            if ($sysPol -and $sysPol.EnableLinkedConnections -ne $null) {
+                $linkedConnections = [int]$sysPol.EnableLinkedConnections
+            }
+        } catch {}
+    }
+
+    return [PSCustomObject]@{
+        UserName                 = $currentIdentity.Name
+        UserSid                  = $currentIdentity.User.Value
+        SessionId                = $currentProc.SessionId
+        IsElevatedAdministrator  = $isElevated
+        EnableLinkedConnections  = $linkedConnections
+        SessionNotes             = "Mount must run in same Windows Logon Session (SessionId: $($currentProc.SessionId)) as the backend application for drive letters to be visible."
+    }
+}
+
+function Get-SystemCapacityInfo {
+    $totalRamMB = 0
+    $freeRamMB = 0
+    try {
+        $os = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop
+        if ($os) {
+            $totalRamMB = [math]::Round($os.TotalVisibleMemorySize / 1024, 2)
+            $freeRamMB = [math]::Round($os.FreePhysicalMemory / 1024, 2)
+        }
+    } catch {
+        # Fallback if CIM instance is restricted
+    }
+
+    $systemDriveFreeGB = 0
+    try {
+        $sysDriveLetter = "C"
+        if ($env:SystemDrive) {
+            $sysDriveLetter = $env:SystemDrive.TrimEnd(':')
+        }
+        $sysDrive = Get-PSDrive -Name $sysDriveLetter -ErrorAction SilentlyContinue
+        if ($sysDrive -and $sysDrive.Free) {
+            $systemDriveFreeGB = [math]::Round($sysDrive.Free / 1GB, 2)
+        }
+    } catch {}
+
+    return [PSCustomObject]@{
+        TotalMemoryMB      = $totalRamMB
+        FreeMemoryMB       = $freeRamMB
+        HasSufficientRam   = ($freeRamMB -ge 128)
+        SystemDriveFreeGB  = $systemDriveFreeGB
+    }
+}
+
+function Check-RcloneConfigSafe {
+    param([string]$Path)
+
+    $result = [PSCustomObject]@{
+        Specified       = $false
+        ConfigPath      = $null
+        FileExists      = $false
+        FileSizeBytes   = 0
+        IsSafe          = $true
+        Note            = "Secret tokens and config contents are strictly omitted to prevent credential exposure."
+    }
+
+    $targetConfig = $Path
+    if (-not $targetConfig) {
+        $appDataPath = ""
+        if ($env:APPDATA) {
+            $appDataPath = $env:APPDATA
+        }
+        if ($appDataPath) {
+            $defaultConfig = Join-Path $appDataPath "rclone\rclone.conf"
+            if (Test-Path -Path $defaultConfig -PathType Leaf -ErrorAction SilentlyContinue) {
+                $targetConfig = $defaultConfig
+            }
+        }
+    } else {
+        $result.Specified = $true
+    }
+
+    if ($targetConfig) {
+        $result.ConfigPath = $targetConfig
+        if (Test-Path -Path $targetConfig -PathType Leaf -ErrorAction SilentlyContinue) {
+            $result.FileExists = $true
+            try {
+                $item = Get-Item -Path $targetConfig -ErrorAction SilentlyContinue
+                if ($item) {
+                    $result.FileSizeBytes = $item.Length
+                }
+            } catch {}
+        }
+    }
+
+    return $result
+}
+
+# ----------------- MAIN EXECUTION -----------------
+
+# 1. OS Info
+$osCaption = "Unknown Windows"
+$osVersion = [System.Environment]::OSVersion.VersionString
+try {
+    $osInfo = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction SilentlyContinue
+    if ($osInfo) {
+        $osCaption = $osInfo.Caption
+        $osVersion = $osInfo.Version
+    }
+} catch {}
+
+$osObj = [PSCustomObject]@{
+    Caption      = $osCaption
+    Version      = $osVersion
+    Architecture = $env:PROCESSOR_ARCHITECTURE
+    IsWindows    = $true
+}
+
+# 2. Rclone detection
+$rcloneExe = Find-RcloneExecutable -ExplicitPath $RclonePath
+$rcloneVersion = $null
+if ($rcloneExe) {
+    try {
+        $verRaw = & $rcloneExe "version" 2>&1
+        if ($verRaw) {
+            $firstLine = ($verRaw | Select-Object -First 1).ToString().Trim()
+            $rcloneVersion = $firstLine
+        }
+    } catch {
+        $rcloneVersion = "Error reading version: $($_.Exception.Message)"
+    }
+}
+
+$rcloneObj = [PSCustomObject]@{
+    Installed       = [bool]$rcloneExe
+    ExecutablePath  = $rcloneExe
+    Version         = $rcloneVersion
+    InstallGuideUrl = "https://rclone.org/install/"
+}
+
+# 3. WinFsp detection
+$winfspObj = Test-WinFspInstalled
+
+# 4. Mount point availability
+$mountObj = Test-MountPointAvailable -Target $MountPoint
+
+# 5. User session
+$sessionObj = Get-UserSessionInfo
+
+# 6. Capacity
+$capacityObj = Get-SystemCapacityInfo
+
+# 7. Config safety check
+$configObj = Check-RcloneConfigSafe -Path $ConfigPath
+
+# 8. Readiness assessment
+$reasons = @()
+if (-not $rcloneObj.Installed) {
+    $reasons += "rclone executable is not found in PATH or standard install paths. Run 'winget install Rclone.Rclone' or download from https://rclone.org."
+}
+if (-not $winfspObj.Installed) {
+    $reasons += "WinFsp is not installed or registered. WinFsp is required on Windows for rclone mount. Run 'winget install WinFsp.WinFsp' or download from https://winfsp.dev."
+}
+if (-not $mountObj.Available) {
+    $reasons += "Mount target '$MountPoint' is unavailable: $($mountObj.ConflictReason)"
+}
+if (-not $capacityObj.HasSufficientRam) {
+    $reasons += "Free physical RAM is critically low ($($capacityObj.FreeMemoryMB) MB < 128 MB threshold)."
+}
+
+$isReady = ($reasons.Count -eq 0)
+
+$report = [PSCustomObject]@{
+    Timestamp          = [DateTime]::UtcNow.ToString("o")
+    IsReady            = $isReady
+    Status             = $(if ($isReady) { "READY" } else { "BLOCKED" })
+    BlockReasons       = $reasons
+    HostOS             = $osObj
+    Rclone             = $rcloneObj
+    WinFsp             = $winfspObj
+    MountTarget        = $mountObj
+    UserSession        = $sessionObj
+    SystemCapacity     = $capacityObj
+    RcloneConfigFile   = $configObj
+}
+
+# Output strictly structured JSON
+$report | ConvertTo-Json -Depth 6
diff --git a/scripts/drive/status_drive.ps1 b/scripts/drive/status_drive.ps1
new file mode 100644
index 0000000..ae2d776
--- /dev/null
+++ b/scripts/drive/status_drive.ps1
@@ -0,0 +1,221 @@
+<#
+.SYNOPSIS
+    Queries and verifies the health and operational status of the Google Drive mount.
+.DESCRIPTION
+    Checks active rclone processes against state JSON (validating PID, process name,
+    and start time to prevent PID reuse misreports). Inspects mount target accessibility.
+    Returns status: MOUNTED, NOT_MOUNTED, or DEGRADED with explanatory diagnostic reasons.
+    Does NOT leak secrets, tokens, or credential contents.
+.PARAMETER MountPoint
+    Target mount point to verify (default "M:").
+.PARAMETER StateFile
+    Path to runtime process state JSON. Defaults to $env:TEMP\movie-rcm-drive-mount.json.
+.PARAMETER AsJson
+    Output status strictly as JSON string.
+#>
+[CmdletBinding()]
+param(
+    [string]$MountPoint = "M:",
+    [string]$StateFile,
+    [switch]$AsJson
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+if (-not $StateFile) {
+    $tempDir = if ($env:TEMP) { $env:TEMP } else { [System.IO.Path]::GetTempPath() }
+    $StateFile = Join-Path $tempDir "movie-rcm-drive-mount.json"
+}
+
+$stateExists = Test-Path -Path $StateFile -PathType Leaf -ErrorAction SilentlyContinue
+$stateData = $null
+if ($stateExists) {
+    try {
+        $stateRaw = Get-Content -Path $StateFile -Raw -Encoding UTF8
+        if ($stateRaw) {
+            $stateData = $stateRaw | ConvertFrom-Json
+        }
+    } catch {
+        # State file read or parse error
+    }
+}
+
+# Determine effective target mount point
+$targetMount = $MountPoint
+if ($stateData -and $stateData.mountPoint) {
+    $targetMount = $stateData.mountPoint
+}
+
+# Helper to check if a drive or directory is accessible
+function Test-MountAccessibility {
+    param([string]$Target)
+
+    $access = [PSCustomObject]@{
+        Exists       = $false
+        IsReadable   = $false
+        DriveFormat  = $null
+        ErrorMessage = $null
+    }
+
+    if (-not $Target) {
+        return $access
+    }
+
+    try {
+        if ($Target -match "^[A-Za-z]:?\\?$") {
+            $letter = $Target.Substring(0, 1).ToUpper()
+            $prefix = "$($letter):\"
+            $drives = [System.IO.DriveInfo]::GetDrives()
+            $matched = $drives | Where-Object { $_.Name.StartsWith($prefix, [System.StringComparison]::OrdinalIgnoreCase) }
+            if ($matched) {
+                $access.Exists = $true
+                try {
+                    $access.DriveFormat = $matched.DriveFormat
+                    $access.IsReadable = $matched.IsReady
+                } catch {
+                    $access.ErrorMessage = $_.Exception.Message
+                }
+            } else {
+                # Fallback to Test-Path
+                if (Test-Path -Path $Target -ErrorAction SilentlyContinue) {
+                    $access.Exists = $true
+                    $access.IsReadable = $true
+                }
+            }
+        } else {
+            if (Test-Path -Path $Target -ErrorAction SilentlyContinue) {
+                $access.Exists = $true
+                # Test directory readability
+                $null = Get-ChildItem -Path $Target -ErrorAction Stop | Select-Object -First 1
+                $access.IsReadable = $true
+            }
+        }
+    } catch {
+        $access.ErrorMessage = $_.Exception.Message
+    }
+
+    return $access
+}
+
+$mountAccess = Test-MountAccessibility -Target $targetMount
+
+# Scenario 1: No state file recorded
+if (-not $stateExists -or -not $stateData) {
+    $status = "NOT_MOUNTED"
+    $reason = "No state file found at '$StateFile'."
+
+    if ($mountAccess.Exists) {
+        $status = "DEGRADED"
+        $reason = "Mount point '$targetMount' is present in the filesystem, but no state file was found at '$StateFile' (untracked or external mount)."
+    }
+
+    $res = [PSCustomObject]@{
+        Timestamp    = [DateTime]::UtcNow.ToString("o")
+        Status       = $status
+        Reason       = $reason
+        MountPoint   = $targetMount
+        StateFile    = $StateFile
+        PID          = $null
+        ProcessAlive = $false
+        Accessible   = $mountAccess.IsReadable
+        RemoteTarget = $null
+    }
+
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# Scenario 2: State file recorded, inspect process
+$savedPid = $stateData.pid
+$proc = $null
+if ($savedPid) {
+    $proc = Get-Process -Id $savedPid -ErrorAction SilentlyContinue
+}
+
+# Process does not exist
+if (-not $proc) {
+    $status = "NOT_MOUNTED"
+    $reason = "Recorded rclone process (PID $savedPid) is not active."
+    if ($mountAccess.Exists) {
+        $status = "DEGRADED"
+        $reason = "Recorded process (PID $savedPid) has exited, but mount point '$targetMount' is still held or stale."
+    }
+
+    $res = [PSCustomObject]@{
+        Timestamp    = [DateTime]::UtcNow.ToString("o")
+        Status       = $status
+        Reason       = $reason
+        MountPoint   = $targetMount
+        StateFile    = $StateFile
+        PID          = $savedPid
+        ProcessAlive = $false
+        Accessible   = $mountAccess.IsReadable
+        RemoteTarget = $stateData.remoteTarget
+    }
+
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# Process exists - validate identity to protect against PID reuse
+$isRcloneProcess = ($proc.ProcessName -ieq "rclone")
+$startTimeMatch = $true
+if ($stateData.startTime) {
+    try {
+        $expectedStart = [DateTimeOffset]::Parse([string]$stateData.startTime)
+        $actualStart = [DateTimeOffset]::new($proc.StartTime)
+        $diffSeconds = [math]::Abs(($actualStart - $expectedStart).TotalSeconds)
+        if ($diffSeconds -gt 5) {
+            $startTimeMatch = $false
+        }
+    } catch {
+        # If parsing fails, fall back to string equality check
+        if ($stateData.startTime -ne $proc.StartTime.ToString("o")) {
+            $startTimeMatch = $false
+        }
+    }
+}
+
+if (-not $isRcloneProcess -or -not $startTimeMatch) {
+    $status = "DEGRADED"
+    $reason = "PID $savedPid is occupied by a different process ('$($proc.ProcessName)', StartTime: $($proc.StartTime.ToString('o'))). PID reuse detected."
+
+    $res = [PSCustomObject]@{
+        Timestamp    = [DateTime]::UtcNow.ToString("o")
+        Status       = $status
+        Reason       = $reason
+        MountPoint   = $targetMount
+        StateFile    = $StateFile
+        PID          = $savedPid
+        ProcessAlive = $true
+        Accessible   = $mountAccess.IsReadable
+        RemoteTarget = $stateData.remoteTarget
+    }
+
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# Genuine rclone process confirmed running
+if ($mountAccess.IsReadable) {
+    $status = "MOUNTED"
+    $reason = "Verified rclone mount process (PID $savedPid) is running and mount target '$targetMount' is accessible."
+} else {
+    $status = "DEGRADED"
+    $reason = "Verified rclone mount process (PID $savedPid) is running, but mount target '$targetMount' is not yet readable or accessible."
+}
+
+$res = [PSCustomObject]@{
+    Timestamp    = [DateTime]::UtcNow.ToString("o")
+    Status       = $status
+    Reason       = $reason
+    MountPoint   = $targetMount
+    StateFile    = $StateFile
+    PID          = $savedPid
+    ProcessAlive = $true
+    Accessible   = $mountAccess.IsReadable
+    RemoteTarget = $stateData.remoteTarget
+}
+
+if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
diff --git a/scripts/drive/stop_drive.ps1 b/scripts/drive/stop_drive.ps1
new file mode 100644
index 0000000..9e7d0de
--- /dev/null
+++ b/scripts/drive/stop_drive.ps1
@@ -0,0 +1,174 @@
+<#
+.SYNOPSIS
+    Safely terminates an rclone Google Drive mount process on Windows.
+.DESCRIPTION
+    Reads state JSON and strictly verifies the recorded PID against process name,
+    executable path, and process start time before termination.
+    Prevents killing unrelated processes or other user rclone instances (no broad kill-by-name).
+    Cleans up the state file upon successful termination.
+.PARAMETER StateFile
+    Path to runtime process state JSON. Defaults to $env:TEMP\movie-rcm-drive-mount.json.
+.PARAMETER Force
+    Force kill the verified rclone process.
+.PARAMETER AsJson
+    Output results strictly as JSON string.
+#>
+[CmdletBinding()]
+param(
+    [string]$StateFile,
+    [switch]$Force,
+    [switch]$AsJson
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+if (-not $StateFile) {
+    $tempDir = if ($env:TEMP) { $env:TEMP } else { [System.IO.Path]::GetTempPath() }
+    $StateFile = Join-Path $tempDir "movie-rcm-drive-mount.json"
+}
+
+if (-not (Test-Path -Path $StateFile -PathType Leaf -ErrorAction SilentlyContinue)) {
+    $res = [PSCustomObject]@{
+        Success   = $false
+        Status    = "NOT_FOUND"
+        PID       = $null
+        Message   = "State file '$StateFile' was not found. No tracked rclone mount process to stop."
+        StateFile = $StateFile
+    }
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# Read state JSON
+$stateRaw = Get-Content -Path $StateFile -Raw -Encoding UTF8
+$stateData = $null
+try {
+    $stateData = $stateRaw | ConvertFrom-Json
+} catch {
+    throw "Corrupted or unreadable state file at '$StateFile': $($_.Exception.Message)"
+}
+
+if (-not $stateData -or -not $stateData.pid) {
+    Remove-Item -Path $StateFile -Force -ErrorAction SilentlyContinue
+    $res = [PSCustomObject]@{
+        Success   = $true
+        Status    = "CLEANED_EMPTY_STATE"
+        PID       = $null
+        Message   = "State file did not contain a valid PID. Cleaned up state file."
+        StateFile = $StateFile
+    }
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+$targetPid = [int]$stateData.pid
+$proc = Get-Process -Id $targetPid -ErrorAction SilentlyContinue
+
+# If process is already terminated, clean up state file
+if (-not $proc) {
+    Remove-Item -Path $StateFile -Force -ErrorAction SilentlyContinue
+    $res = [PSCustomObject]@{
+        Success   = $true
+        Status    = "ALREADY_STOPPED"
+        PID       = $targetPid
+        Message   = "Process with PID $targetPid is already inactive. Cleaned up state file."
+        StateFile = $StateFile
+    }
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# ================= PID REUSE & IDENTITY VERIFICATION =================
+# Check 1: Process Name must be rclone
+if ($proc.ProcessName -ine "rclone") {
+    $res = [PSCustomObject]@{
+        Success    = $false
+        Status     = "PID_REUSE_REJECTED"
+        PID        = $targetPid
+        ActualName = $proc.ProcessName
+        Message    = "Refusing to kill PID $($targetPid): active process name is '$($proc.ProcessName)', which does not match expected process 'rclone'. Process identity mismatch / PID reuse detected."
+        StateFile  = $StateFile
+    }
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# Check 2: Start time verification
+$startTimeMatch = $true
+$recordedStartStr = [string]$stateData.startTime
+if ($recordedStartStr) {
+    try {
+        $expectedStart = [DateTimeOffset]::Parse($recordedStartStr)
+        $actualStart = [DateTimeOffset]::new($proc.StartTime)
+        $diffSeconds = [math]::Abs(($actualStart - $expectedStart).TotalSeconds)
+        if ($diffSeconds -gt 5) {
+            $startTimeMatch = $false
+        }
+    } catch {
+        if ($recordedStartStr -ne $proc.StartTime.ToString("o")) {
+            $startTimeMatch = $false
+        }
+    }
+}
+
+if (-not $startTimeMatch) {
+    $res = [PSCustomObject]@{
+        Success           = $false
+        Status            = "PID_REUSE_REJECTED"
+        PID               = $targetPid
+        ActualStartTime   = $proc.StartTime.ToString("o")
+        ExpectedStartTime = $recordedStartStr
+        Message           = "Refusing to kill PID $($targetPid): process start time ($($proc.StartTime.ToString('o'))) does not match recorded state ($recordedStartStr). PID reuse detected."
+        StateFile         = $StateFile
+    }
+    if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
+    return
+}
+
+# ================= TERMINATION OF VERIFIED PROCESS =================
+try {
+    Stop-Process -Id $targetPid -Force:$Force -ErrorAction Stop
+
+    # Wait up to 5 seconds for process termination
+    $exited = $false
+    for ($i = 0; $i -lt 10; $i++) {
+        if (-not (Get-Process -Id $targetPid -ErrorAction SilentlyContinue)) {
+            $exited = $true
+            break
+        }
+        Start-Sleep -Milliseconds 500
+    }
+
+    if ($exited) {
+        Remove-Item -Path $StateFile -Force -ErrorAction SilentlyContinue
+        $res = [PSCustomObject]@{
+            Success    = $true
+            Status     = "STOPPED"
+            PID        = $targetPid
+            MountPoint = $stateData.mountPoint
+            Message    = "Successfully stopped verified rclone mount process (PID $targetPid)."
+            StateFile  = $StateFile
+        }
+    } else {
+        $res = [PSCustomObject]@{
+            Success    = $false
+            Status     = "STOP_TIMEOUT"
+            PID        = $targetPid
+            MountPoint = $stateData.mountPoint
+            Message    = "Process (PID $targetPid) was signaled to stop, but was still running after 5 seconds."
+            StateFile  = $StateFile
+        }
+    }
+} catch {
+    $res = [PSCustomObject]@{
+        Success    = $false
+        Status     = "STOP_ERROR"
+        PID        = $targetPid
+        MountPoint = $stateData.mountPoint
+        Message    = "Failed to stop process (PID $targetPid): $($_.Exception.Message)"
+        StateFile  = $StateFile
+    }
+}
+
+if ($AsJson) { $res | ConvertTo-Json -Depth 5 } else { $res }
diff --git a/scripts/drive/test_drive_tooling.ps1 b/scripts/drive/test_drive_tooling.ps1
new file mode 100644
index 0000000..a737f96
--- /dev/null
+++ b/scripts/drive/test_drive_tooling.ps1
@@ -0,0 +1,278 @@
+<#
+.SYNOPSIS
+    Automated test suite for Google Drive PowerShell operational tooling.
+.DESCRIPTION
+    Validates:
+    1. Preflight execution is read-only, idempotent, and produces complete structured JSON.
+    2. mount_drive defaults to dry-run/WhatIf and enforces exact baseline streaming flags.
+    3. stop_drive validates PID identity (process name and start time) and refuses PID reuse kills.
+    4. status_drive correctly reports MOUNTED, NOT_MOUNTED, and DEGRADED states.
+    5. Zero secret or token leakage across logs, outputs, and dry-run commands.
+.OUTPUTS
+    Test summary table and exit code 0 (success) or 1 (failure).
+#>
+[CmdletBinding()]
+param(
+    [switch]$VerboseOutput
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+$scriptDir = $PSScriptRoot
+$preflightPath = Join-Path $scriptDir "preflight_drive.ps1"
+$mountPath     = Join-Path $scriptDir "mount_drive.ps1"
+$statusPath    = Join-Path $scriptDir "status_drive.ps1"
+$stopPath      = Join-Path $scriptDir "stop_drive.ps1"
+
+$testResults = @()
+
+function Assert-Condition {
+    param(
+        [string]$TestName,
+        [bool]$Condition,
+        [string]$FailureMessage
+    )
+
+    if ($Condition) {
+        Write-Host "  [PASS] $TestName" -ForegroundColor Green
+        return [PSCustomObject]@{
+            TestName = $TestName
+            Passed   = $true
+            Details  = "OK"
+        }
+    } else {
+        Write-Host "  [FAIL] $TestName - $FailureMessage" -ForegroundColor Red
+        return [PSCustomObject]@{
+            TestName = $TestName
+            Passed   = $false
+            Details  = $FailureMessage
+        }
+    }
+}
+
+Write-Host "==========================================================" -ForegroundColor Cyan
+Write-Host " RUNNING GOOGLE DRIVE WINDOWS TOOLING TEST SUITE (DRIVE-01)" -ForegroundColor Cyan
+Write-Host "==========================================================" -ForegroundColor Cyan
+
+# -------------------------------------------------------------
+# TEST 1: Preflight Read-Only Behavior & Schema Verification
+# -------------------------------------------------------------
+Write-Host "`nTest Suite 1: Preflight Read-Only & JSON Schema" -ForegroundColor Yellow
+
+$preSnapshotFiles = (Get-ChildItem -Path $scriptDir -Recurse | Select-Object -ExpandProperty FullName)
+
+$preflightRaw = & $preflightPath -MountPoint "M:"
+$preflightJson = $null
+$parseSuccess = $false
+try {
+    $preflightJson = $preflightRaw | ConvertFrom-Json
+    $parseSuccess = ($preflightJson -ne $null)
+} catch {
+    $parseSuccess = $false
+}
+
+$testResults += Assert-Condition -TestName "Preflight outputs valid JSON" -Condition $parseSuccess -FailureMessage "Failed to parse JSON output"
+
+if ($preflightJson) {
+    $hasRequiredKeys = ($preflightJson.PSObject.Properties['HostOS'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['Rclone'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['WinFsp'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['MountTarget'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['UserSession'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['SystemCapacity'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['IsReady'] -ne $null) -and `
+                       ($preflightJson.PSObject.Properties['Status'] -ne $null)
+
+    $testResults += Assert-Condition -TestName "Preflight schema contains all required sections" `
+        -Condition $hasRequiredKeys `
+        -FailureMessage "Missing expected JSON sections"
+
+    $winfspHasChecks = ($preflightJson.WinFsp.PSObject.Properties['RegistryFound'] -ne $null) -and `
+                       ($preflightJson.WinFsp.PSObject.Properties['DllFound'] -ne $null) -and `
+                       ($preflightJson.WinFsp.PSObject.Properties['DriverLoaded'] -ne $null)
+
+    $testResults += Assert-Condition -TestName "WinFsp checks include Registry, DLL, and Driver checks" `
+        -Condition $winfspHasChecks `
+        -FailureMessage "WinFsp checks incomplete"
+}
+
+$postSnapshotFiles = (Get-ChildItem -Path $scriptDir -Recurse | Select-Object -ExpandProperty FullName)
+$fileDiff = Compare-Object -ReferenceObject $preSnapshotFiles -DifferenceObject $postSnapshotFiles
+$noFileSystemChange = ($fileDiff -eq $null -or $fileDiff.Count -eq 0)
+
+$testResults += Assert-Condition -TestName "Preflight is strictly read-only (zero filesystem modifications)" `
+    -Condition $noFileSystemChange `
+    -FailureMessage "Preflight created or modified files in scripts dir"
+
+# -------------------------------------------------------------
+# TEST 2: Mount Drive WhatIf / Dry-Run Baseline Flags
+# -------------------------------------------------------------
+Write-Host "`nTest Suite 2: Mount Drive Baseline Flags & Dry-Run" -ForegroundColor Yellow
+
+$mountPlan = & $mountPath -WhatIf -Remote "cinema-gdrive:" -RemoteSubpath "DippieMedia" -MountPoint "M:"
+$isPlanObject = ($mountPlan -ne $null)
+$testResults += Assert-Condition -TestName "mount_drive -WhatIf returns structured plan" -Condition $isPlanObject -FailureMessage "mount_drive returned null"
+
+if ($mountPlan) {
+    $isDryRun = ($mountPlan.Mode -eq "DRY_RUN") -and ($mountPlan.IsExecute -eq $false)
+    $testResults += Assert-Condition -TestName "mount_drive is in DRY_RUN mode" -Condition $isDryRun -FailureMessage "Mode is not DRY_RUN"
+
+    $cmd = [string]$mountPlan.ExpectedCommand
+    $hasReadOnly      = $cmd -match "--read-only"
+    $hasVfsCacheOff   = $cmd -match "--vfs-cache-mode\s+off"
+    $hasBufferSize32M = $cmd -match "--buffer-size\s+32M"
+    $hasChunkSize8M   = $cmd -match "--vfs-read-chunk-size\s+8M"
+    $hasChunkLimit32M = $cmd -match "--vfs-read-chunk-size-limit\s+32M"
+    $hasChunkStreams0 = $cmd -match "--vfs-read-chunk-streams\s+0"
+    $hasRemoteTarget  = $cmd -match "cinema-gdrive:DippieMedia"
+    $hasMountPoint    = ($cmd -match "(^|\s)M:(\s|$)") -and ($mountPlan.MountPoint -eq "M:")
+
+    $allBaselineFlags = $hasReadOnly -and $hasVfsCacheOff -and $hasBufferSize32M -and `
+                        $hasChunkSize8M -and $hasChunkLimit32M -and $hasChunkStreams0
+
+    $testResults += Assert-Condition -TestName "Command includes all baseline streaming flags (--read-only, --vfs-cache-mode off, --buffer-size 32M, chunk 8M/32M, streams 0)" `
+        -Condition $allBaselineFlags `
+        -FailureMessage "Missing baseline flags in expected command: $cmd"
+
+    $testResults += Assert-Condition -TestName "Command mounts target 'cinema-gdrive:DippieMedia' to 'M:'" `
+        -Condition ($hasRemoteTarget -and $hasMountPoint) `
+        -FailureMessage "Remote target or mount point mismatched in command: $cmd"
+}
+
+# Verify default invocation without -Execute is also dry-run
+$defaultPlan = & $mountPath
+$testResults += Assert-Condition -TestName "mount_drive defaults to dry-run when -Execute is omitted" `
+    -Condition ($defaultPlan -and $defaultPlan.Mode -eq "DRY_RUN") `
+    -FailureMessage "Omitting -Execute did not default to dry-run"
+
+# -------------------------------------------------------------
+# TEST 3: Stop Drive PID Identity Verification (PID Reuse Protection)
+# -------------------------------------------------------------
+Write-Host "`nTest Suite 3: Stop Drive PID Reuse & Identity Protection" -ForegroundColor Yellow
+
+$tempStateFile = Join-Path ([System.IO.Path]::GetTempPath()) "test-drive-mount-state-$([Guid]::NewGuid().ToString('N')).json"
+
+# Create a state file containing the current PowerShell process PID, but claiming to be rclone with a mismatched start time
+$currentProc = Get-Process -Id $PID
+$fakeState = [PSCustomObject]@{
+    pid            = $currentProc.Id
+    processName    = "rclone"
+    startTime      = [DateTimeOffset]::UtcNow.AddDays(-1).ToString("o")
+    executablePath = "C:\rclone\rclone.exe"
+    mountPoint     = "M:"
+    remoteTarget   = "cinema-gdrive:DippieMedia"
+}
+$fakeState | ConvertTo-Json | Set-Content -Path $tempStateFile -Encoding UTF8
+
+$stopResult = & $stopPath -StateFile $tempStateFile
+$refusedKill = ($stopResult -and $stopResult.Status -eq "PID_REUSE_REJECTED" -and $stopResult.Success -eq $false)
+
+$testResults += Assert-Condition -TestName "stop_drive refuses to kill process when process identity / start time does not match" `
+    -Condition $refusedKill `
+    -FailureMessage "stop_drive did not reject mismatched PID (Result: $($stopResult.Status))"
+
+# Verify current process was indeed NOT killed and is continuing execution
+$currentStillAlive = (Get-Process -Id $PID -ErrorAction SilentlyContinue) -ne $null
+$testResults += Assert-Condition -TestName "Current process remained alive and protected from accidental termination" `
+    -Condition $currentStillAlive `
+    -FailureMessage "Current process was unexpectedly terminated"
+
+# Clean up temp state file
+if (Test-Path -Path $tempStateFile) {
+    Remove-Item -Path $tempStateFile -Force -ErrorAction SilentlyContinue
+}
+
+# -------------------------------------------------------------
+# TEST 4: Status Drive Verification
+# -------------------------------------------------------------
+Write-Host "`nTest Suite 4: Status Drive States (MOUNTED, NOT_MOUNTED, DEGRADED)" -ForegroundColor Yellow
+
+$nonExistentState = Join-Path ([System.IO.Path]::GetTempPath()) "nonexistent-state-$([Guid]::NewGuid().ToString('N')).json"
+$statusResult = & $statusPath -StateFile $nonExistentState
+$testResults += Assert-Condition -TestName "status_drive reports NOT_MOUNTED when state file does not exist" `
+    -Condition ($statusResult -and $statusResult.Status -eq "NOT_MOUNTED") `
+    -FailureMessage "Status was $($statusResult.Status), expected NOT_MOUNTED"
+
+# Test dead PID state
+$deadPidStateFile = Join-Path ([System.IO.Path]::GetTempPath()) "deadpid-state-$([Guid]::NewGuid().ToString('N')).json"
+$deadState = [PSCustomObject]@{
+    pid            = 999998
+    processName    = "rclone"
+    startTime      = [DateTimeOffset]::UtcNow.ToString("o")
+    mountPoint     = "Z:"
+    remoteTarget   = "cinema-gdrive:DippieMedia"
+}
+$deadState | ConvertTo-Json | Set-Content -Path $deadPidStateFile -Encoding UTF8
+
+$deadStatusResult = & $statusPath -StateFile $deadPidStateFile
+$testResults += Assert-Condition -TestName "status_drive reports NOT_MOUNTED for inactive PID" `
+    -Condition ($deadStatusResult -and $deadStatusResult.Status -eq "NOT_MOUNTED") `
+    -FailureMessage "Status was $($deadStatusResult.Status), expected NOT_MOUNTED"
+
+if (Test-Path -Path $deadPidStateFile) {
+    Remove-Item -Path $deadPidStateFile -Force -ErrorAction SilentlyContinue
+}
+
+# -------------------------------------------------------------
+# TEST 5: Secret and Token Hygiene
+# -------------------------------------------------------------
+Write-Host "`nTest Suite 5: Secret and Token Leakage Prevention" -ForegroundColor Yellow
+
+$dummySecretToken   = "ya29.MOCK_SECRET_ACCESS_TOKEN_XYZ_1234567890"
+$dummyClientSecret  = "MOCK_TOP_SECRET_GOOGLE_CLIENT_KEY_998877"
+$dummyConfigFile    = Join-Path ([System.IO.Path]::GetTempPath()) "dummy-rclone-$([Guid]::NewGuid().ToString('N')).conf"
+
+$dummyConfContent = @"
+[cinema-gdrive]
+type = drive
+client_id = 123456789-mockclient.apps.googleusercontent.com
+client_secret = $dummyClientSecret
+scope = drive.readonly
+token = {"access_token":"$dummySecretToken","token_type":"Bearer","refresh_token":"1//mock-refresh-token","expiry":"2030-01-01T00:00:00Z"}
+"@
+Set-Content -Path $dummyConfigFile -Value $dummyConfContent -Encoding UTF8
+
+$preflightSecretOutput = & $preflightPath -ConfigPath $dummyConfigFile | Out-String
+$mountSecretOutput     = & $mountPath -WhatIf -ConfigPath $dummyConfigFile | Out-String
+
+$tokenInPreflight  = $preflightSecretOutput.Contains($dummySecretToken)
+$secretInPreflight = $preflightSecretOutput.Contains($dummyClientSecret)
+$tokenInMount      = $mountSecretOutput.Contains($dummySecretToken)
+$secretInMount     = $mountSecretOutput.Contains($dummyClientSecret)
+
+$hasAnyLeak = ($tokenInPreflight -or $secretInPreflight -or $tokenInMount -or $secretInMount)
+
+$testResults += Assert-Condition -TestName "Strict secret hygiene: zero tokens or secrets present in preflight or mount output" `
+    -Condition (-not $hasAnyLeak) `
+    -FailureMessage "Detected token or secret in output! Preflight leaked: $($tokenInPreflight -or $secretInPreflight); Mount leaked: $($tokenInMount -or $secretInMount)"
+
+if (Test-Path -Path $dummyConfigFile) {
+    Remove-Item -Path $dummyConfigFile -Force -ErrorAction SilentlyContinue
+}
+
+# -------------------------------------------------------------
+# SUMMARY REPORT
+# -------------------------------------------------------------
+Write-Host "`n==========================================================" -ForegroundColor Cyan
+Write-Host " TEST EXECUTION SUMMARY" -ForegroundColor Cyan
+Write-Host "==========================================================" -ForegroundColor Cyan
+
+$passedCount = @($testResults | Where-Object { $_.Passed }).Count
+$failedCount = @($testResults | Where-Object { -not $_.Passed }).Count
+$totalCount  = @($testResults).Count
+
+Write-Host "Total Tests : $totalCount"
+Write-Host "Passed      : $passedCount" -ForegroundColor $(if ($passedCount -eq $totalCount) { "Green" } else { "Yellow" })
+Write-Host "Failed      : $failedCount" -ForegroundColor $(if ($failedCount -eq 0) { "Green" } else { "Red" })
+
+if ($failedCount -gt 0) {
+    Write-Host "`nFAILED TESTS:" -ForegroundColor Red
+    $testResults | Where-Object { -not $_.Passed } | ForEach-Object {
+        Write-Host " - $($_.TestName): $($_.Details)" -ForegroundColor Red
+    }
+    exit 1
+} else {
+    Write-Host "`nALL TESTS PASSED SUCCESSFULLY." -ForegroundColor Green
+    exit 0
+}
diff --git a/scripts/drive_mapping_suite.cjs b/scripts/drive_mapping_suite.cjs
new file mode 100644
index 0000000..bb247a4
--- /dev/null
+++ b/scripts/drive_mapping_suite.cjs
@@ -0,0 +1,379 @@
+#!/usr/bin/env node
+/**
+ * DRIVE-01 Automated Test Suite for Google Drive Media Mapping Tools
+ *
+ * Verifies mapping manifest schema integrity, conflict detection, path security,
+ * mount physical file verification, and idempotency.
+ *
+ * Test Runner: Node.js built-in test runner (`node --test`)
+ *
+ * Usage:
+ *   node --test scripts/drive_mapping_suite.cjs
+ *   node scripts/drive_mapping_suite.cjs
+ */
+
+const { describe, it } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const os = require('node:os');
+const { execFileSync } = require('node:child_process');
+
+const {
+  validateManifest,
+  validateAsset,
+  isSafeRelativePath,
+  normalizeMountPath,
+  checkMountFiles,
+} = require('./preview_drive_media_mapping.cjs');
+
+const PROJECT_ROOT = path.resolve(__dirname, '..');
+const FIXTURE_PATH = path.resolve(PROJECT_ROOT, 'docs/fixtures/drive_media_mapping.example.json');
+const SCRIPT_PATH = path.resolve(__dirname, 'preview_drive_media_mapping.cjs');
+
+describe('DRIVE-01: Drive Media Mapping & Validation Suite', () => {
+
+  // Test 1: Manifest mẫu hợp lệ pass 100%
+  it('1. Authoritative sample manifest passes 100% validation', () => {
+    assert.ok(fs.existsSync(FIXTURE_PATH), `Fixture file must exist at ${FIXTURE_PATH}`);
+    const result = validateManifest(FIXTURE_PATH);
+
+    assert.equal(result.isValid, true, 'Default manifest must be completely valid');
+    assert.equal(result.schemaErrors.length, 0, 'Must have zero schema errors');
+    assert.equal(result.conflicts.length, 0, 'Must have zero conflicts');
+    assert.equal(result.unsafePaths.length, 0, 'Must have zero unsafe paths');
+    assert.equal(result.totalAssets, 12, 'Must contain 12 sample assets');
+    assert.equal(result.validAssetsCount, 12, 'All 12 assets must be valid');
+
+    // Also verify CLI execution directly
+    const stdout = execFileSync(process.execPath, [SCRIPT_PATH, '--manifest', FIXTURE_PATH], {
+      encoding: 'utf8',
+    });
+    assert.match(stdout, /VALIDATION PASSED/, 'CLI output must report VALIDATION PASSED');
+    assert.match(stdout, /Total Assets:\s+12/, 'CLI must report 12 total assets');
+  });
+
+  // Test 2: Phát hiện lỗi schema (thiếu trường bắt buộc, sai kiểu dữ liệu)
+  it('2. Detects schema violations (missing required fields, invalid data types)', () => {
+    // 2.1 Missing required fields
+    const missingAssetId = {
+      movieId: 'm-test-2026',
+      storageProvider: 'drive',
+      relativePath: 'movies/m-test-2026/v1/feature.mp4',
+      kind: 'feature',
+      mimeType: 'video/mp4',
+      byteLength: 1048576,
+      version: 'v1',
+      isPublic: true,
+    };
+    const r1 = validateAsset(missingAssetId, 1);
+    assert.equal(r1.valid, false, 'Missing assetId must be flagged');
+    assert.match(r1.errors[0], /"assetId" is required/);
+
+    // 2.2 Invalid kind
+    const invalidKind = {
+      assetId: 'ast-test-01',
+      movieId: 'm-test-2026',
+      storageProvider: 'drive',
+      relativePath: 'movies/m-test-2026/v1/feature.mp4',
+      kind: 'bonus_clip',
+      mimeType: 'video/mp4',
