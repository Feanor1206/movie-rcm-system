+    }
+    $evidenceDoc.suites | Add-Member -MemberType NoteProperty -Name "security_seams" -Value $suiteObj -Force
+
+    # Recalculate summary across all recorded suites
+    $allTotal = 0
+    $allPassed = 0
+    $allFailed = 0
+    foreach ($p in $evidenceDoc.suites.PSObject.Properties) {
