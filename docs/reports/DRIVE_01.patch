+      key,
+      code,
+      windowsVirtualKeyCode,
+      nativeVirtualKeyCode: windowsVirtualKeyCode,
+    });
+  }
+
+  return {
+    proc: chromeProc,
+    ws,
+    tmpDir,
+    cdp,
+    evaluate,
+    waitForCondition,
+    setViewport,
+    navigate,
+    captureScreenshot,
