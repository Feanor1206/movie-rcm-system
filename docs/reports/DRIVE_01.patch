+    # Second call: detects file gone and returns NOT_FOUND
+    $call2 = & $stopPath -StateFile $idempotentStatePath
+    $t14Sw.Stop()
+
+    $p14Passed = ($call1.Status -eq "ALREADY_STOPPED") -and ($call2.Status -eq "NOT_FOUND")
