+            assertTrue(dc.isClosed(), "Drive channel " + i + " must report isClosed() == true");
+
+            // Wait for physical closure to finish
+            boolean closed = waitForCondition(() -> !tracked.isOpen() && tracked.getCloseCount() >= 1, 3000);
