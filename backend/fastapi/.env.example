# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000

# Chế độ phục vụ: 'full' (Qwen3-4B + Phase23 LoRA) hoặc 'light' (Qwen3-0.6B GGUF)
SERVING_MODE=full
USE_FULL_QWEN3_4B_LORA=true

# Device configuration: 'cuda', 'cpu', hoặc 'auto'
DEVICE=cuda

# Fallback và Readiness policy
ENABLE_FALLBACK=false
STRICT_READINESS=true

# Model & Adapter paths
BASE_MODEL_NAME=Qwen/Qwen3-4B
PHASE23_ADAPTER_DIR=../../ai/models/qwen3-4b-phase23-lora
MODEL_NAME_OR_PATH=../../ai/models/qwen-0.6b

# Giới hạn tài nguyên và Token
MAX_CONCURRENT_INFERENCE=1
MAX_NEW_TOKENS=256
TEMPERATURE=0.7
